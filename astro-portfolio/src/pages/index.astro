  // ================================================================
  // TERMINAL GESTURE INTERACTIONS
  // Apple Design principles: rubber-banding, momentum, velocity handoff
  // TUI/niri aesthetic: sharp edges, subtle animations, no bounce
  // ================================================================

  const termWrap = document.getElementById('term-wrapper');
  const termOutput = document.getElementById('term-output');
  const termResizeHandle = document.getElementById('term-resize-handle');
  const termControls = document.getElementById('term-controls');
  const termMinBtn = document.getElementById('term-minimize-btn');
  const termMaxBtn = document.getElementById('term-maximize-btn');

  if (termWrap && termOutput) {
    // ----------------------------------------------------------------
    // State
    // ----------------------------------------------------------------
    const MIN_OUTPUT_HEIGHT = 80;
    const MAX_OUTPUT_HEIGHT = 600;
    const DEFAULT_OUTPUT_HEIGHT = parseInt(getComputedStyle(termOutput).maxHeight) || 400;
    const MIN_WIDTH = 240;
    const MAX_WIDTH = 800;

    const histSize = 5;
    const rubberbandConst = 0.55;
    const decelRate = 0.995;
    const flickThreshold = 600;
    let springStiffness = 0.08;
    let springDamping = 0.75;

    let isResizing = false;
    let isDragging = false;
    let isMinimized = false;
    let isMaximized = false;

    let resizeStartX = 0, resizeStartY = 0;
    let resizeStartW = 0, resizeStartH = 0;
    let dragStartY = 0;
    let dragStartOutputH = 0;

    let posHistory = [];
    let springId = null;

    let storedOutputHeight = DEFAULT_OUTPUT_HEIGHT;
    let storedWidth = termWrap.offsetWidth;

    // ----------------------------------------------------------------
    // Physics helpers
    // ----------------------------------------------------------------

    function rubberband(delta, limit, c) {
      if (Math.abs(delta) <= 0) return delta;
      const sign = delta > 0 ? 1 : -1;
      const absDelta = Math.abs(delta);
      return sign * ((absDelta * limit * c) / (limit + c * absDelta));
    }

    function project(vel, d) {
      return (vel / 1000) * d / (1 - d);
    }

    function clamp(v, min, max) {
      return Math.max(min, Math.min(max, v));
    }

    function calcVelocity(history) {
      if (history.length < 2) return 0;
      const newest = history[history.length - 1];
      const oldest = history[0];
      const dt = (newest.t - oldest.t) / 1000;
      if (dt <= 0) return 0;
      return (newest.y - oldest.y) / dt;
    }

    // ----------------------------------------------------------------
    // Spring settle animation
    // ----------------------------------------------------------------

    function startSpring(current, target, initialVel, applyFn, onSettle) {
      if (springId) cancelAnimationFrame(springId);

      let pos = current;
      let vel = initialVel || 0;

      function tick() {
        const force = (target - pos) * springStiffness;
        vel += force;
        vel *= springDamping;
        pos += vel;

        applyFn(pos);

        if (Math.abs(target - pos) < 0.5 && Math.abs(vel) < 0.5) {
          applyFn(target);
          springId = null;
          if (onSettle) onSettle();
          return;
        }

        springId = requestAnimationFrame(tick);
      }

      springId = requestAnimationFrame(tick);
    }

    // ----------------------------------------------------------------
    // Size application with rubber-banding
    // ----------------------------------------------------------------

    function applyOutputHeight(rawHeight) {
      let displayHeight = rawHeight;

      if (rawHeight < MIN_OUTPUT_HEIGHT) {
        const overshoot = rawHeight - MIN_OUTPUT_HEIGHT;
        displayHeight = MIN_OUTPUT_HEIGHT + rubberband(overshoot, MIN_OUTPUT_HEIGHT, rubberbandConst);
      } else if (rawHeight > MAX_OUTPUT_HEIGHT) {
        const overshoot = rawHeight - MAX_OUTPUT_HEIGHT;
        displayHeight = MAX_OUTPUT_HEIGHT + rubberband(overshoot, MAX_OUTPUT_HEIGHT, rubberbandConst);
      }

      termOutput.style.maxHeight = displayHeight + 'px';
      termOutput.style.height = displayHeight + 'px';
    }

    function applyWidth(rawWidth) {
      let displayWidth = rawWidth;

      if (rawWidth < MIN_WIDTH) {
        const overshoot = rawWidth - MIN_WIDTH;
        displayWidth = MIN_WIDTH + rubberband(overshoot, MIN_WIDTH, rubberbandConst);
      } else if (rawWidth > MAX_WIDTH) {
        const overshoot = rawWidth - MAX_WIDTH;
        displayWidth = MAX_WIDTH + rubberband(overshoot, MAX_WIDTH, rubberbandConst);
      }

      termWrap.style.width = displayWidth + 'px';
    }

    // ----------------------------------------------------------------
    // Resize handle
    // ----------------------------------------------------------------

    if (termResizeHandle) {
      termResizeHandle.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        e.stopPropagation();

        if (springId) cancelAnimationFrame(springId);
        springId = null;

        termWrap.classList.add('resizing');
        isResizing = true;
        resizeStartX = e.clientX;
        resizeStartY = e.clientY;
        resizeStartW = termWrap.offsetWidth;
        resizeStartH = termOutput.offsetHeight;

        posHistory = [{ y: e.clientY, t: performance.now() }];

        termResizeHandle.setPointerCapture(e.pointerId);
        termWrap.style.transition = 'none';
        termOutput.style.transition = 'none';
      });

      termResizeHandle.addEventListener('pointermove', (e) => {
        if (!isResizing) return;
        e.preventDefault();

        const dx = e.clientX - resizeStartX;
        const dy = e.clientY - resizeStartY;

        applyWidth(resizeStartW + dx);
        applyOutputHeight(resizeStartH + dy);

        posHistory.push({ y: e.clientY, t: performance.now() });
        if (posHistory.length > histSize) posHistory.shift();
      });

      termResizeHandle.addEventListener('pointerup', (e) => {
        if (!isResizing) return;
        isResizing = false;

        termWrap.classList.remove('resizing');
        termResizeHandle.releasePointerCapture(e.pointerId);

        const vel = calcVelocity(posHistory);
        const currentHeight = termOutput.offsetHeight;
        const currentWidth = termWrap.offsetWidth;

        if (Math.abs(vel) > flickThreshold) {
          const projection = project(vel, decelRate);
          const targetHeight = clamp(currentHeight + projection, MIN_OUTPUT_HEIGHT, MAX_OUTPUT_HEIGHT);

          startSpring(currentHeight, targetHeight, vel, (h) => {
            termOutput.style.maxHeight = h + 'px';
            termOutput.style.height = h + 'px';
            termOutput.style.transition = '';
          }, () => {
            if (targetHeight <= MIN_OUTPUT_HEIGHT + 20 && Math.abs(vel) > flickThreshold * 1.5) {
              minimizeTerminal();
            }
          });

          let snapW = currentWidth;
          if (currentWidth < MIN_WIDTH + 40) snapW = MIN_WIDTH;
          else if (currentWidth > MAX_WIDTH - 40) snapW = MAX_WIDTH;
          termWrap.style.transition = 'width 300ms cubic-bezier(0.16, 1, 0.3, 1)';
          termWrap.style.width = snapW + 'px';
        } else {
          const snapH = clamp(currentHeight, MIN_OUTPUT_HEIGHT, MAX_OUTPUT_HEIGHT);

          if (Math.abs(currentHeight - snapH) > 1) {
            startSpring(currentHeight, snapH, vel, (h) => {
              termOutput.style.maxHeight = h + 'px';
              termOutput.style.height = h + 'px';
            });
          }

          let snapW = currentWidth;
          if (currentWidth < MIN_WIDTH) snapW = MIN_WIDTH;
          else if (currentWidth > MAX_WIDTH) snapW = MAX_WIDTH;
          if (Math.abs(currentWidth - snapW) > 1) {
            termWrap.style.transition = 'width 200ms cubic-bezier(0.16, 1, 0.3, 1)';
            termWrap.style.width = snapW + 'px';
          } else {
            termWrap.style.transition = '';
          }
        }

        posHistory = [];
        storedWidth = termWrap.offsetWidth;
      });
    }

    // ----------------------------------------------------------------
    // Titlebar drag for flick-to-minimize/maximize
    // ----------------------------------------------------------------

    const titlebarEl = termWrap.querySelector('.flex.items-center');

    if (titlebarEl) {
      titlebarEl.addEventListener('pointerdown', (e) => {
        if (springId) cancelAnimationFrame(springId);
        springId = null;

        isDragging = true;
        dragStartY = e.clientY;
        dragStartOutputH = termOutput.offsetHeight;

        posHistory = [{ y: e.clientY, t: performance.now() }];

        titlebarEl.setPointerCapture(e.pointerId);
        termOutput.style.transition = 'none';
        termWrap.style.transition = 'none';
        termWrap.style.cursor = 'grabbing';
      });

      titlebarEl.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        e.preventDefault();

        const dy = e.clientY - dragStartY;
        applyOutputHeight(dragStartOutputH - dy);

        posHistory.push({ y: e.clientY, t: performance.now() });
        if (posHistory.length > histSize) posHistory.shift();
      });

      titlebarEl.addEventListener('pointerup', (e) => {
        if (!isDragging) return;
        isDragging = false;

        titlebarEl.releasePointerCapture(e.pointerId);
        termWrap.style.cursor = '';

        const vel = calcVelocity(posHistory);
        const currentHeight = termOutput.offsetHeight;

        // Detect flick gestures
        if (vel > flickThreshold && currentHeight < MIN_OUTPUT_HEIGHT + 40) {
          // Flicked downward — minimize
          startSpring(currentHeight, MIN_OUTPUT_HEIGHT, vel, (h) => {
            termOutput.style.maxHeight = h + 'px';
            termOutput.style.height = h + 'px';
          }, () => {
            minimizeTerminal();
            termOutput.style.transition = '';
          });
          return;
        }

        if (vel < -flickThreshold && currentHeight > MAX_OUTPUT_HEIGHT - 40) {
          // Flicked upward — maximize
          startSpring(currentHeight, MAX_OUTPUT_HEIGHT, vel, (h) => {
            termOutput.style.maxHeight = h + 'px';
            termOutput.style.height = h + 'px';
          }, () => {
            maximizeTerminal();
            termOutput.style.transition = '';
          });
          return;
        }

        // Otherwise snap to nearest bound with spring
        const snapH = clamp(currentHeight, MIN_OUTPUT_HEIGHT, MAX_OUTPUT_HEIGHT);

        if (Math.abs(currentHeight - snapH) > 1) {
          startSpring(currentHeight, snapH, vel, (h) => {
            termOutput.style.maxHeight = h + 'px';
            termOutput.style.height = h + 'px';
          }, () => {
            termOutput.style.transition = '';
          });
        } else {
          termOutput.style.transition = '';
        }

        storedOutputHeight = clamp(termOutput.offsetHeight, 200, MAX_OUTPUT_HEIGHT);
        posHistory = [];
      });
    }

    // ----------------------------------------------------------------
    // Minimize / Maximize
    // ----------------------------------------------------------------

    function minimizeTerminal() {
      isMinimized = true;
      isMaximized = false;
      termWrap.classList.add('minimized');
      termWrap.classList.remove('maximized');

      termOutput.style.maxHeight = '0px';
      termOutput.style.height = '0px';
      termOutput.style.overflow = 'hidden';
      termOutput.style.padding = '0';
      termOutput.style.minHeight = '0';

      const inputRow = termWrap.querySelector('.border-t');
      if (inputRow && inputRow !== titlebarEl) {
        inputRow.style.display = 'none';
      }

      termWrap.style.transition = '';
      termControls.style.display = 'flex';

      if (termMinBtn) termMinBtn.textContent = '▢';
    }

    function maximizeTerminal() {
      isMaximized = true;
      isMinimized = false;
      termWrap.classList.add('maximized');
      termWrap.classList.remove('minimized');

      termOutput.style.maxHeight = MAX_OUTPUT_HEIGHT + 'px';
      termOutput.style.height = MAX_OUTPUT_HEIGHT + 'px';
      termOutput.style.overflow = 'auto';
      termOutput.style.padding = '1rem';
      termOutput.scrollTop = termOutput.scrollHeight;

      const inputRow = termWrap.querySelector('.border-t');
      if (inputRow && inputRow !== titlebarEl) {
        inputRow.style.display = '';
      }

      storedOutputHeight = MAX_OUTPUT_HEIGHT;

      termWrap.style.transition = '';
      termControls.style.display = 'flex';
    }

    function restoreTerminal() {
      isMinimized = false;
      isMaximized = false;
      termWrap.classList.remove('minimized', 'maximized');

      const restoreH = storedOutputHeight || DEFAULT_OUTPUT_HEIGHT;

      termOutput.style.maxHeight = restoreH + 'px';
      termOutput.style.height = restoreH + 'px';
      termOutput.style.overflow = 'auto';
      termOutput.style.padding = '';
      termOutput.style.minHeight = '';

      const inputRow = termWrap.querySelector('.border-t');
      if (inputRow && inputRow !== titlebarEl) {
        inputRow.style.display = '';
      }

      termWrap.style.transition = '';
      termControls.style.display = 'none';
    }

    // ----------------------------------------------------------------
    // Control buttons
    // ----------------------------------------------------------------

    if (termMinBtn) {
      termMinBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isMinimized) {
          restoreTerminal();
          termMinBtn.textContent = '_';
        } else {
          minimizeTerminal();
        }
      });
    }

    if (termMaxBtn) {
      termMaxBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isMaximized) {
          restoreTerminal();
        } else {
          if (isMinimized) {
            restoreTerminal();
            setTimeout(() => maximizeTerminal(), 50);
          } else {
            maximizeTerminal();
          }
        }
      });
    }

    // ----------------------------------------------------------------
    // Show controls on hover
    // ----------------------------------------------------------------

    termWrap.addEventListener('mouseenter', () => {
      termControls.style.display = 'flex';
      requestAnimationFrame(() => {
        termControls.style.opacity = '1';
      });
    });

    termWrap.addEventListener('mouseleave', () => {
      if (!isMinimized && !isMaximized) {
        termControls.style.opacity = '0';
        setTimeout(() => {
          if (termControls.style.opacity === '0') {
            termControls.style.display = 'none';
          }
        }, 200);
      }
    });

    // ----------------------------------------------------------------
    // Keyboard focus for accessibility
    // ----------------------------------------------------------------

    termWrap.addEventListener('focusin', () => {
      termControls.style.display = 'flex';
      termControls.style.opacity = '1';
    });

    termWrap.addEventListener('focusout', (e) => {
      if (!termWrap.contains(e.relatedTarget)) {
        if (!isMinimized && !isMaximized) {
          termControls.style.opacity = '0';
          setTimeout(() => {
            if (termControls.style.opacity === '0') {
              termControls.style.display = 'none';
            }
          }, 200);
        }
      }
    });

    // ----------------------------------------------------------------
    // Reduced motion support
    // ----------------------------------------------------------------

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      // Skip spring loop entirely - snap instantly
      function startSpring(current, target, initialVel, applyFn, onSettle) {
        applyFn(target);
        if (onSettle) onSettle();
      }
    }
  }
</script>

