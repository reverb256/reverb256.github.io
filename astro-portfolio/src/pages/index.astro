---
import Layout from "../layouts/Layout.astro";
import { CLUSTER_DATA } from "../lib/infrastructure-data";

// Deep terminal database
const db = {
  subjects: [
    { id: "JOURNEY_001", title: "MY JOURNEY", category: "PERSONAL", classification: "PUBLIC", content: ["15 years in food service - learned work ethic, teamwork, customer service", "20 years curious about computers - tinkering, researching, learning", "Full-time Linux user since Sept 2025 - building ReverbOS, my own OS", "Pivoted to web dev and AI infrastructure through self-teaching", "Building skills every day, open to opportunities", "Philosophy: Never too late to change paths"], related: ["PERSONAL", "CAREER"] },
    { id: "HYVRS_001", title: "HOYOVERSE", category: "INSPIRATION", classification: "PUBLIC", content: ["Chinese game developer known for Genshin Impact, Honkai Star Rail, Zenless Zone Zero.", "Key design principles:", "• Non-intrusive UI with progressive disclosure", "• Anticipatory animation sequencing", "• Secondary motion polish (particles, glows)", "• Character-first special moves", "• Dynamic tooltip reveals", "Reference: UI/UX patterns studied for portfolio redesign."], related: ["GAME_DESIGN", "ANIMATION", "UI_UX"] },
    { id: "PHIL_042", title: "PHILOSOPHY", category: "KNOWLEDGE", classification: "INTERNAL", content: ["EXISTENTIALISM: Freedom through code creation", "DETERMINISM: Owned declarative systems (ReverbOS)", "DIALECTICS: Iterative development cycles", "PHENOMENOLOGY: User experience as lived reality", "STOICISM: Embracing technical constraints", "TRANSHUMANISM: Human-AI symbiosis", "Application: Design decisions grounded in first principles."], related: ["DESIGN_PHILOSOPHY", "DEVELOPMENT"] },
    { id: "VRCH_107", title: "VRCHAT", category: "INSPIRATION", classification: "RESTRICTED", content: ["Social VR platform observations:", "• Avatar expression as identity projection", "• Spatial audio design for immersion", "• World-building with Unity SDK", "• Community-driven content creation", "• Performance optimization for VR", "Note: Explored avatar creation pipeline."], related: ["3D_GRAPHICS", "UNITY", "SOCIAL_DESIGN"] },
    { id: "NIX_999", title: "REVERBOS MANIFESTO", category: "TECHNOLOGY", classification: "TOP SECRET", content: ["OWNED OPERATING SYSTEM MANIFESTO", "Core tenets:", "1. Reproducibility over convenience", "2. Atomic upgrades and rollbacks", "3. Declarative system configuration", "4. Own every layer - no rented package ecosystem", "5. Sovereign, auditable, zero external dependency", "Current deployment: Full cluster - zephyr, nexus, forge, sentry", "Journey: NixOS proved the model; ReverbOS owns the result"], related: ["DEVOPS", "DECLARATIVE_SYSTEMS", "SOVEREIGNTY"] },
    { id: "ANIM_033", title: "ANIME", category: "INSPIRATION", classification: "PUBLIC", content: ["GHOST IN THE SHELL: Transhumanism, tech philosophy", "EVANGELION: Psychological depth, mecha aesthetics", "COWBOY BEBOP: Style, music, episodic narrative", "STEINS;GATE: Time manipulation, cause/effect", "PSYCHO-PASS: Surveillance society themes", "Serial Experiments LAIN: Internet consciousness", "Applied: Dark color schemes, cyberpunk aesthetics"], related: ["VISUAL_DESIGN", "STORYTELLING"] },
    { id: "GAME_256", title: "GAMING HISTORY", category: "PERSONAL", classification: "PUBLIC", content: ["1998: Fallout - Choice & consequence", "2000: Deus Ex - Immersive sim design", "2004: WoW - Social systems, progression", "2011: Dark Souls - Environmental storytelling", "2017: BOTW - Emergent gameplay", "2020: Genshin - Gacha + open world", "2023: BG3 - CRPG renaissance", "Total hours: [CLASSIFIED]"], related: ["GAME_DESIGN", "STORYTELLING"] },
    { id: "TECH_001", title: "STACK", category: "TECHNOLOGY", classification: "INTERNAL", content: ["LANGUAGES: TypeScript, Go, Python, Rust", "FRONTEND: React, Astro, Tailwind, GSAP", "BACKEND: Node.js, Express, FastAPI", "DATABASE: PostgreSQL, Redis, SQLite", "INFRA: Omarchy/ReverbOS, Docker, Kubernetes", "AI/ML: MCP, Local LLMs, Self-hosted inference, Qdrant"], related: ["PROGRAMMING", "INFRASTRUCTURE"] },
    { id: "TERM_GLOS", title: "GLOSSARY", category: "REFERENCE", classification: "PUBLIC", content: ["DECK: Development workstation", "ICE: Security measures / firewalls", "RUN: Active development session", "CHROME: User interface elements", "DARK: Undocumented features", "WAREZ: Open source tools", "GRID: Network / internet", "MEATSPACE: Physical reality", "WIZARD: Expert programmer"], related: ["TERMINOLOGY"] },
    { id: "CYBR_2077", title: "CYBERPUNK", category: "INSPIRATION", classification: "RESTRICTED", content: ["High tech, low life aesthetic", "Neuromancer - William Gibson", "Snow Crash - Neal Stephenson", "Blade Runner - Visual language", "Akira - Neo-Tokyo aesthetics", "Applied: Neon accents, dark themes, terminal UIs"], related: ["VISUAL_DESIGN", "ANIME"] },
    { id: "AI_001", title: "AI INTEGRATION", category: "TECHNOLOGY", classification: "TOP SECRET", content: ["ACTIVE SYSTEMS:", "• Claude (Anthropic) - Primary coding assistant", "• GPT-4 - Research and analysis", "• Local LLMs - Privacy-sensitive tasks", "• OpenCode - Terminal-based AI TUI", "Philosophy: AI as force multiplier, not replacement"], related: ["DEVELOPMENT", "PHILOSOPHY"] },
    { id: "MUSC_420", title: "MUSIC", category: "PERSONAL", classification: "PUBLIC", content: ["Coding soundtracks:", "• Synthwave (Perturbator, Carpenter Brut)", "• Lo-fi hip hop (focus sessions)", "• Electronic (Daft Punk, Justice)", "• Post-rock (Explosions in the Sky)", "• J-Pop/Rock (Anime OPs)"], related: ["PERSONAL"] },
    { id: "SEC_101", title: "SECURITY", category: "TECHNOLOGY", classification: "RESTRICTED", content: ["OPSEC Practices:", "• Full disk encryption (LUKS)", "• GPG for commits and emails", "• Hardware security keys (YubiKey)", "• Network isolation (VLANs)", "• Regular security audits"], related: ["DEVOPS", "INFRASTRUCTURE"] },
    { id: "CLUSTER_001", title: "REVERBOS CLUSTER", category: "TECHNOLOGY", classification: "TOP SECRET", content: ["4-HOST OWNED INFRASTRUCTURE:", "• Zephyr: RTX 3090 + 3060 Ti (main workstation)", "• Nexus: 1x NVIDIA (downstairs)", "• Forge: 2x RTX 4060 + 2x RX 5700 XT", "• Sentry: 1x AMD", "ReverbOS declarative deployment across every host", "Kubernetes orchestration in production", "Comprehensive documentation system with agent automation"], related: ["DEVOPS", "INFRASTRUCTURE", "NIX_999"] },
    { id: "PROJ_001", title: "RECENT PROJECTS", category: "KNOWLEDGE", classification: "PUBLIC", content: ["CLIENT WORK:", "• Troves & Coves - React e-commerce with shadcn/ui", "• Local Cleaning Service - service business site", "", "PERSONAL PROJECTS:", "• Frostbite Gazette - AI-curated accountability journalism", "• Astral Key - Rust Web3/FIDO2 authentication microservice", "• COREFLAME Protocol - consciousness-driven development", "", "INFRASTRUCTURE:", "• ReverbOS - owned Omarchy-based OS across 4 hosts", "All projects feature strict TypeScript, comprehensive documentation", "Production deployments on Cloudflare Workers, Pages"], related: ["DEVELOPMENT", "TECH_001"] },
    { id: "MCP_001", title: "MCP INTEGRATION", category: "TECHNOLOGY", classification: "INTERNAL", content: ["Model Context Protocol servers:", "• Pinecone - Vector database operations", "• Context7 - Live documentation lookup", "• Stripe - Payment integration", "• Web Reader - URL content extraction", "Philosophy: Composable AI tooling via stdio JSON-RPC"], related: ["DEVELOPMENT", "AI_001"] },
  ],
  categories: ["INSPIRATION", "KNOWLEDGE", "TECHNOLOGY", "PERSONAL", "REFERENCE"],
  classifications: ["PUBLIC", "INTERNAL", "RESTRICTED", "TOP SECRET"],
};

const projects = {
  client: [
    { title: "Troves & Coves", repo: "trovesandcoves", desc: "Crystal jewelry e-commerce", status: "active", icon: "💎", span: "2x2", tech: ["React", "TypeScript", "shadcn/ui"], metric: "Client" },
    { title: "hair@home", repo: null, desc: "Hugo static site", status: "experiment", icon: "💇", span: "1x1", tech: ["Hugo", "SCSS"], metric: "Experiment" },
  ],
  personal: [
    { title: "Knowledge Fabric", repo: "knowledge-fabric", desc: "Qdrant vector search with RRF fusion & wiki compilation", status: "active", icon: "🧠", span: "2x2", tech: ["TypeScript", "Qdrant", "Omarchy"], metric: "Active" },
    { title: "Astral Key", repo: "astral-key", desc: "Web3/FIDO2/Passkey auth microservice", status: "active", icon: "🔑", span: "1x1", tech: ["Rust", "Axum", "PostgreSQL", "Redis"], metric: "Active" },
    { title: "Synapse", repo: "synapse", desc: "Local-first AI command center", status: "experiment", icon: "⚡", span: "2x1", tech: ["Node.js", "Tauri", "WebSocket"], metric: "Experiment" },
    { title: "MapleSpike", repo: null, desc: "Canada's sovereign AI gov data pipeline — PII-free by design (Decision 0002)", status: "active", icon: "🍁", span: "2x2", tech: ["TypeScript", "Astro", "pnpm packages"], metric: "Active" },
    { title: "Frostbite Gazette", repo: "Frostbite-Gazette", desc: "AI-curated Canadian journalism", status: "active", icon: "🍁", span: "1x1", tech: ["Astro", "Cloudflare", "Groq AI"], metric: "Active" },
  ],
  infra: [
    { title: "ReverbOS Cluster", repo: "nixos-config", desc: "4-host owned cluster — GitOps, VR gaming, mining, AI inference", status: "live", icon: "🖥️", span: "2x2", tech: ["Omarchy", "ReverbOS", "K8s", "Tailscale"], metric: "Flagship", link: "/infrastructure" },
    { title: "Compute Market", repo: "compute-market", desc: "GPU time-slicing market for burst AI inference workloads", status: "active", icon: "💰", span: "1x1", tech: ["Omarchy", "Python", "Prometheus"], metric: "Infra" },
    { title: "MCP Registry", repo: "mcp-registry", desc: "Declarative MCP server management, deployed across every host", status: "active", icon: "🔌", span: "1x1", tech: ["Omarchy", "JSON", "MCP"], metric: "Infra" },
    { title: "Caddy Ingress", repo: "caddy-ingress", desc: "Custom Caddy build + declarative OS module + container image", status: "active", icon: "🌐", span: "1x1", tech: ["Go", "Omarchy", "Docker"], metric: "Infra" },
    { title: "GPU Proxy", repo: "gpu-proxy", desc: "C++ stratum mining proxy v2.0 with SSL & pool management", status: "active", icon: "⛏️", span: "1x1", tech: ["C++", "Boost", "SSL"], metric: "Infra" },
  ],
  meta: [
    { title: "This Portfolio", repo: null, desc: "Astro + GSAP + Terminal", status: "live", icon: "🌐", span: "1x1", tech: ["Astro", "GSAP"], metric: "reverb256.ca" },
  ],
};

const categoryColors = {
  client: "var(--base09)",    // ember orange
  personal: "var(--base0D)",  // turquoise
  infra: "var(--base0B)",     // green
  meta: "var(--base05)",      // gray
};

const skills = ["TypeScript", "React", "Rust", "Node.js", "Omarchy", "Astro", "Tailwind", "Python", "FastAPI", "FastMCP", "Qdrant", "Axum", "Tauri", "Docker", "Kubernetes", "K3s", "MCP", "CUDA", "ROCm", "Prometheus", "Grafana", "Redis", "PostgreSQL", "GSAP", "Cloudflare", "GitHub Actions", "Vaultwarden", "ReverbOS", "Tailscale"];
---

<Layout
  title="Reverb256"
  description="AI Systems Orchestrator & Private Infrastructure Architect. Self-hosted LLM + agent + infrastructure stacks clients own. Reverb256 — building sovereign, auditable AI infrastructure from Winnipeg on an owned Omarchy cluster."
>
    <!-- ═══════════════════════════════════════════════════
         HERO — Terminal + The Hook
         ═══════════════════════════════════════════════════ -->
    <section id="hero" class="min-h-screen px-6 relative overflow-hidden" aria-labelledby="hero-heading">
      <!-- Subtle grid overlay for terminal aesthetic -->
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;" aria-hidden="true"></div>
      
      <div class="beat-indicator mb-6" aria-hidden="true"></div>
      <div class="max-w-6xl mx-auto w-full grid lg:grid-cols-2 gap-12 items-center min-h-[80vh] relative z-10">
        <!-- Left: Info -->
        <div class="space-y-6" data-animate="fade-up">
          <!-- NixOS ASCII art from zephyr's fastfetch — floating behind the text -->
          <div id="nixos-logo" class="absolute left-0 top-0 opacity-[0.04] pointer-events-none select-none leading-none" style="font-family: 'Fira Code', 'Noto Sans Mono', monospace; font-size: clamp(0.8rem, 2.5vw, 1.6rem); white-space: pre; line-height: 1.05; color: var(--base0D); transform: translate(-15%, -8%);" aria-hidden="true">
            <div>  ▗▄   ▗▄ ▄▖</div>
            <div> ▄▄▄▄▄▄▄██▛ ▃</div>
            <div>   ▟▛    ▜▃▟</div>
            <div> ██      ██</div>
            <div> ▟▛▙    ▟▛</div>
            <div> ▟██▀▀▀██▀▀</div>
            <div>  ▝▀ ▀▘   ▀▘</div>
          </div>
          <div class="inline-flex items-center gap-2 px-3 py-1 glass text-xs text-[var(--base05)]" role="status">
            <span class="w-2 h-2 rounded-full bg-[var(--base0B)] animate-pulse" aria-hidden="true"></span>
            <span style="font-family: 'Fira Code', monospace;">$ status: building</span>
          </div>
          
          <h1 id="hero-heading" class="text-5xl md:text-7xl font-bold leading-none">
            <span class="text-[var(--base07)] block">Reverb256</span>
            <span class="block text-lg md:text-xl font-mono text-[var(--base05)] font-normal mt-3 leading-relaxed" style="font-family: 'Fira Code', monospace;">
              <span class="text-[var(--base09)]">15 years</span> in food service.
              <span class="text-[var(--base0D)]">20 years</span> curious about computers.<br>
              Now I build <span class="text-[var(--base09)]">sovereign AI infrastructure</span>.
            </span>
          </h1>
          
          <p class="text-base text-[var(--base05)] max-w-lg leading-relaxed">
            4 owned hosts on a self-built Omarchy OS. 7 GPUs. Zero cloud spend. 
            Canadian government data pipelines. AI consciousness research. 
            Accountability journalism. All self-hosted from Winnipeg.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href="#arc" class="btn-accent">
              <span class="font-mono text-xs mr-2 opacity-70">$</span>
              Read the story
            </a>
            <a href="/craft" class="btn-outline">
              <span class="font-mono text-xs mr-2 opacity-70">$</span>
              View my craft
            </a>
          </div>
          
          <div class="flex gap-8 pt-4">
            <div class="group">
              <span class="stat-number text-3xl font-bold font-display text-[var(--base09)]">53</span><br>
              <span class="text-[10px] text-[var(--base04)] font-mono uppercase tracking-wider">Public repos</span>
            </div>
            <div class="group">
              <span class="stat-number text-3xl font-bold font-display text-[var(--base09)]">4</span><br>
              <span class="text-[10px] text-[var(--base04)] font-mono uppercase tracking-wider">Owned hosts</span>
            </div>
            <div class="group">
              <span class="stat-number text-3xl font-bold font-display text-[var(--base09)]">8</span><br>
              <span class="text-[10px] text-[var(--base04)] font-mono uppercase tracking-wider">GPUs</span>
            </div>
            <div class="group">
              <span class="stat-number text-3xl font-bold font-display text-[var(--base0B)]">$0</span><br>
              <span class="text-[10px] text-[var(--base04)] font-mono uppercase tracking-wider">Cloud spend</span>
            </div>
          </div>
        </div>

        <!-- Right: Terminal -->
        <div data-animate="fade-up" data-delay="0.2" class="relative" style="z-index: 20;">
          <div id="term-wrapper" class="overflow-hidden relative rounded-lg" style="background: var(--base00); border: 1px solid var(--base03); z-index: 30; font-family: 'Fira Code', 'JetBrains Mono', 'SF Mono', Consolas, monospace;" role="region" aria-label="Interactive terminal">
            <!-- Terminal titlebar — niri-inspired, no window dots,
                 just the path like a tmux status or Alacritty title -->
            <!-- Titlebar — touch-action: none so dragging doesn't scroll the page on mobile -->
            <div class="flex items-center px-4 py-1.5" style="background: var(--base01); border-bottom: 1px solid var(--border-default); touch-action: none;">
              <span class="font-mono text-[11px] text-[var(--base04)]">j_kro@zephyr:~/portfolio</span>
            </div>
            <!-- Terminal controls -->
            <div id="term-controls" class="absolute top-1 right-1 z-50 flex gap-0.5 opacity-0 transition-opacity duration-150" style="display: none;">
              <button id="term-minimize-btn" class="w-3.5 h-3.5 flex items-center justify-center text-[7px] border border-[var(--border-default)]" style="background: var(--base01); color: var(--base04); border-radius: 1px;" aria-label="Minimize terminal">_</button>
              <button id="term-maximize-btn" class="w-3.5 h-3.5 flex items-center justify-center text-[7px] border border-[var(--border-default)]" style="background: var(--base01); color: var(--base04); border-radius: 1px;" aria-label="Maximize terminal">□</button>
            </div>
            <!-- Terminal output -->
            <div id="term-output" class="text-sm p-4 min-h-[300px] max-h-[400px] overflow-y-auto" style="font-family: inherit; line-height: 1.6;" role="log" aria-live="polite">
              <p style="color: var(--base05);">Welcome to the R256 knowledge database.</p>
              <p style="color: var(--base05);">Type <span style="color: var(--base0D);">help</span> for commands.</p>
            </div>

            <!-- Terminal input with blinking cursor -->
            <div class="flex items-center px-4 py-2 border-t" style="border-color: var(--base02); background: rgba(0,0,0,0.3); font-family: inherit;">
              <span style="color: var(--base0B);" aria-hidden="true">❯</span>
              <span>&nbsp;</span>
              <input
                type="text"
                id="term-input"
                class="flex-grow bg-transparent border-none outline-none term-prompt"
                style="color: var(--base06); font-family: inherit; caret-color: var(--base0D);"
                placeholder="type a command..."
                autocomplete="off"
                spellcheck="false"
                aria-label="Terminal command input"
                aria-describedby="term-instructions"
              />
            </div>
            <span id="term-instructions" class="sr-only">Type commands like help, list, or read to explore the database</span>
            <!-- Resize handle — bottom-right corner, TUI style.
                 w-10 h-10 provides a 40px touch target for mobile while the ╲ stays small.
                 touch-action: none prevents scroll interference during drag. -->
            <div id="term-resize-handle" class="absolute bottom-0 right-0 w-10 h-10 cursor-nwse-resize z-50 flex items-end justify-end select-none" style="touch-action: none;" aria-label="Drag to resize terminal">
              <span class="text-[8px] leading-none text-[var(--base04)] opacity-40 hover:opacity-80 transition-opacity pointer-events-none select-none" style="font-family: 'Fira Code', monospace; padding: 6px; display: block;">╲</span>
            </div>
          </div>
        </div>
      </div>
      
  </section>

  <!-- ═══════════════════════════════════════════════════
       THE ARC — 3-Act Narrative
       ═══════════════════════════════════════════════════ -->
  <section id="arc" class="px-6 py-24" aria-labelledby="arc-heading">
    <div class="max-w-6xl mx-auto">
      <div class="beat-indicator mb-6" aria-hidden="true"></div>
      <div class="text-center mb-16" data-animate="fade-up">
        <span class="font-mono text-xs text-[var(--base04)] uppercase tracking-widest">// THE ARC</span>
        <h2 id="arc-heading" class="text-4xl md:text-5xl font-display font-bold mt-2" style="background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; color: transparent;">
          A Builder's Evolution
        </h2>
        <p class="text-[var(--base05)] mt-4 max-w-2xl mx-auto">
          The projects are artifacts. The repos are steps. This is the story they tell.
        </p>
      </div>

      <div class="space-y-24">
        <!-- Phase 1: Foundation -->
        <div class="grid md:grid-cols-5 gap-8 items-start" data-animate="fade-up">
          <div class="md:col-span-2">
            <div class="sticky top-28">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 text-[10px] font-mono rounded-full" style="background: rgba(78, 205, 196, 0.15); color: var(--base0B); border: 1px solid rgba(78, 205, 196, 0.3);">ACT I</span>
                <span class="text-xs font-mono text-[var(--base04)]">~1995–2025</span>
              </div>
              <h3 class="text-3xl font-display font-bold text-[var(--base07)]">Foundation</h3>
              <p class="text-sm text-[var(--base05)] mt-4 leading-relaxed">
                IBM 486. DOS Shell. GameCube DNS exploits. 15 years of food service 
                while the obsession never stopped. Crypto mining built the GPU farm 
                before I knew what Kubernetes was.
              </p>
            </div>
          </div>
          <div class="md:col-span-3 space-y-4">
            <div class="surface p-6 flex items-start gap-4">
              <span class="text-2xl mt-1">💻</span>
              <div>
                <h4 class="font-mono text-sm font-bold text-[var(--base06)]">1995 — First Computer</h4>
                <p class="text-xs text-[var(--base05)] mt-1">IBM 486. DOS Shell. The beginning of a lifelong curiosity about how machines work.</p>
              </div>
            </div>
            <div class="surface p-6 flex items-start gap-4">
              <span class="text-2xl mt-1">🎮</span>
              <div>
                <h4 class="font-mono text-sm font-bold text-[var(--base06)]">2004 — GameCube DNS Exploits</h4>
                <p class="text-xs text-[var(--base05)] mt-1">Learning network manipulation through gaming. Modding, exploits, understanding protocols.</p>
              </div>
            </div>
            <div class="surface p-6 flex items-start gap-4">
              <span class="text-2xl mt-1">🍔</span>
              <div>
                <h4 class="font-mono text-sm font-bold text-[var(--base06)]">15 Years in Food Service</h4>
                <p class="text-xs text-[var(--base05)] mt-1">Work ethic. Teamwork. Showing up every day. The tech obsession never stopped — it was just waiting.</p>
              </div>
            </div>
            <div class="surface p-6 flex items-start gap-4" style="border-color: var(--base09);">
              <span class="text-2xl mt-1">⛏️</span>
              <div>
                <h4 class="font-mono text-sm font-bold text-[var(--base09)]">Crypto Mining → GPU Farm</h4>
                <p class="text-xs text-[var(--base05)] mt-1">The GPUs that started as mining rigs became the foundation of an owned cluster. Every tool serves a purpose.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Connector between Phase 1 and Phase 2 -->
        <div class="phase-connector" data-animate="fade-up" aria-hidden="true">
          <span class="phase-connector-dot"></span>
          <span class="text-[10px] font-mono text-[var(--base04)] uppercase tracking-wider">then</span>
          <span class="phase-connector-dot"></span>
        </div>

        <!-- Phase 2: Infrastructure -->
        <div class="grid md:grid-cols-5 gap-8 items-start" data-animate="fade-up">
          <div class="md:col-span-2">
            <div class="sticky top-28">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 text-[10px] font-mono rounded-full" style="background: rgba(255, 159, 92, 0.15); color: var(--base09); border: 1px solid rgba(255, 159, 92, 0.3);">ACT II</span>
                <span class="text-xs font-mono text-[var(--base04)]">2025–2026</span>
              </div>
              <h3 class="text-3xl font-display font-bold text-[var(--base07)]">Infrastructure</h3>
              <p class="text-sm text-[var(--base05)] mt-4 leading-relaxed">
                Killed Windows. Went full Linux. 4 hosts, K3s cluster. 
                All hosts now run ReverbOS — an owned Omarchy-based OS that replaced NixOS. 
                AI Inference Gateway, Knowledge Fabric, MCP Registry, Compute Market. 
                Every service self-hosted. Zero cloud spend.
              </p>
              <a href="/infrastructure" class="inline-flex items-center gap-2 mt-4 text-xs font-mono text-[var(--base09)] hover:text-[var(--base07)] transition-colors">
                View cluster details →
              </a>
            </div>
          </div>
          <div class="md:col-span-3 space-y-4">
            <div class="surface p-6 flex items-start gap-4">
              <span class="text-2xl mt-1">🐧</span>
              <div>
                <h4 class="font-mono text-sm font-bold text-[var(--base06)]">Omarchy → CachyOS → NixOS → ReverbOS</h4>
