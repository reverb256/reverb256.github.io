---
import Layout from "../layouts/Layout.astro";

const db = {
  subjects: [
    { id: "JOURNEY_001", title: "MY JOURNEY", category: "PERSONAL", classification: "PUBLIC", content: ["15 years in food service - learned work ethic, teamwork, customer service", "20 years curious about computers - tinkering, researching, learning", "6 months full-time Linux user - NixOS convert", "Pivoted to web dev through AI-assisted learning", "Building skills every day, open to opportunities", "Philosophy: Never too late to change paths"], related: ["PERSONAL", "CAREER"] },
    { id: "HYVRS_001", title: "HOYOVERSE", category: "INSPIRATION", classification: "PUBLIC", content: ["Chinese game developer known for Genshin Impact, Honkai Star Rail, Zenless Zone Zero.", "Key design principles:", "• Non-intrusive UI with progressive disclosure", "• Anticipatory animation sequencing", "• Secondary motion polish (particles, glows)", "• Character-first special moves", "• Dynamic tooltip reveals", "Reference: UI/UX patterns studied for portfolio redesign."], related: ["GAME_DESIGN", "ANIMATION", "UI_UX"] },
    { id: "PHIL_042", title: "PHILOSOPHY", category: "KNOWLEDGE", classification: "INTERNAL", content: ["EXISTENTIALISM: Freedom through code creation", "DETERMINISM: NixOS declarative systems", "DIALECTICS: Iterative development cycles", "PHENOMENOLOGY: User experience as lived reality", "STOICISM: Embracing technical constraints", "TRANSHUMANISM: Human-AI symbiosis", "Application: Design decisions grounded in first principles."], related: ["DESIGN_PHILOSOPHY", "DEVELOPMENT"] },
    { id: "NIX_999", title: "NIXOS PHILOSOPHY", category: "TECHNOLOGY", classification: "TOP SECRET", content: ["DECLARATIVE CONFIGURATION MANIFESTO", "Core tenets:", "1. Reproducibility over convenience", "2. Atomic upgrades and rollbacks", "3. Declarative system configuration", "4. Reliable package management", "5. Multi-environment support", "Current deployment: Full workstation", "Learning curve: Steep but worth it", "Switched: 6 months ago"], related: ["DEVOPS", "DECLARATIVE_SYSTEMS"] },
    { id: "CLUSTER_001", title: "NIXOS CLUSTER", category: "TECHNOLOGY", classification: "TOP SECRET", content: ["4-HOST MINING INFRASTRUCTURE:", "• Zephyr: RTX 3090 + 3060 Ti (main workstation)", "• Nexus: 1x NVIDIA (downstairs)", "• Forge: 2x RTX 4060 + 2x RX 5700 XT", "• Sentry: 1x AMD", "Colmena multi-host deployment system", "Kubernetes migration in progress (9-week roadmap)", "Comprehensive documentation system with agent automation"], related: ["DEVOPS", "INFRASTRUCTURE", "NIX_999"] },
    { id: "PROJ_001", title: "RECENT PROJECTS", category: "KNOWLEDGE", classification: "PUBLIC", content: ["CLIENT WORK:", "• Troves & Coves - React e-commerce with shadcn/ui", "• hair@home - Hugo static site", "", "PERSONAL PROJECTS:", "• Frostbite Gazette - AI-curated Canadian journalism", "• Astral Key - Rust Web3 authentication microservice", "• Synapse - Local-first AI command center (Tauri)", "", "INFRASTRUCTURE:", "• 4-host NixOS mining cluster with AI monitoring", "All projects feature strict TypeScript, comprehensive documentation", "Production deployments on Cloudflare Workers, GitHub Pages"], related: ["DEVELOPMENT", "TECH_001"] },
    { id: "SEC_101", title: "SECURITY", category: "TECHNOLOGY", classification: "RESTRICTED", content: ["OPSEC Practices:", "• Full disk encryption (LUKS)", "• GPG for commits and emails", "• Hardware security keys (YubiKey)", "• Network isolation (VLANs)", "• Regular security audits"], related: ["DEVOPS", "INFRASTRUCTURE"] },
    { id: "TERM_GLOS", title: "GLOSSARY", category: "REFERENCE", classification: "PUBLIC", content: ["DECK: Development workstation", "ICE: Security measures / firewalls", "RUN: Active development session", "CHROME: User interface elements", "DARK: Undocumented features", "WAREZ: Open source tools", "GRID: Network / internet", "MEATSPACE: Physical reality", "WIZARD: Expert programmer"], related: ["TERMINOLOGY"] },
    { id: "AI_001", title: "AI INTEGRATION", category: "TECHNOLOGY", classification: "TOP SECRET", content: ["ACTIVE SYSTEMS:", "• Claude (Anthropic) - Primary coding assistant", "• GPT-4 - Research and analysis", "• Local LLMs - Privacy-sensitive tasks", "• OpenCode - Terminal-based AI TUI", "Philosophy: AI as force multiplier, not replacement"], related: ["DEVELOPMENT", "PHILOSOPHY"] },
  ],
  categories: ["INSPIRATION", "KNOWLEDGE", "TECHNOLOGY", "PERSONAL", "REFERENCE"],
  classifications: ["PUBLIC", "INTERNAL", "RESTRICTED", "TOP SECRET"],
};

const projects = {
  client: [
    { title: "Troves & Coves", repo: "trovesandcoves", desc: "Crystal jewelry e-commerce", status: "active", icon: "💎", span: "2x2", tech: ["React", "TypeScript", "shadcn/ui"], metric: "Client" },
    { title: "hair@home", repo: null, desc: "Hugo static site", status: "live", icon: "💇", span: "1x1", tech: ["Hugo", "SCSS"], metric: "Client" },
  ],
  personal: [
    { title: "Frostbite Gazette", repo: "Frostbite-Gazette", desc: "AI-curated Canadian journalism", status: "active", icon: "🍁", span: "2x2", tech: ["Astro", "Cloudflare", "Groq AI"], metric: "Active" },
    { title: "Astral Key", repo: "astral-key", desc: "Web3 auth microservice", status: "active", icon: "🔑", span: "1x1", tech: ["Rust", "SQLx", "Axum"], metric: "Active" },
    { title: "Synapse", repo: "synapse", desc: "Local-first AI command center", status: "active", icon: "⚡", span: "2x1", tech: ["Node.js", "Tauri", "WebSocket"], metric: "Active" },
  ],
  infra: [
    { title: "Infrastructure", repo: null, desc: "4-host NixOS cluster with AI monitoring", status: "live", icon: "🖥️", span: "2x2", tech: ["NixOS", "Colmena", "K8s", "AI"], metric: "Flagship", link: "/infrastructure" },
  ],
};

const skills = ["TypeScript", "React", "Rust", "Node.js", "NixOS", "Astro", "Tailwind", "Python", "Cloudflare Workers", "Docker", "Kubernetes", "MCP"];
---

<Layout
  title="Reverb256"
  description="Software developer portfolio showcasing projects in Rust, TypeScript, and NixOS. Building privacy-first AI tools, contributing to open source, and learning in public."
>
  <!-- Hero -->
  <section id="hero" class="min-h-screen px-6" aria-labelledby="hero-heading">
    <div class="beat-indicator mb-6" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto w-full grid lg:grid-cols-2 gap-8 items-center min-h-[80vh]">
      <div class="space-y-6" data-animate="fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 glass text-xs" style="color: var(--text-muted);" role="status">
          <span class="w-2 h-2 rounded-full animate-pulse" style="background: var(--accent-success);" aria-hidden="true"></span>
          Open to Opportunities
        </div>
        <h1 id="hero-heading" class="retro-heading">Reverb256</h1>
        <p class="text-lg max-w-md" style="color: var(--text-secondary);">
          <span style="color: var(--accent-primary);">15 years</span> in food service.
          <span style="color: var(--accent-secondary);">20 years</span> tech-curious.
          Now building <span style="color: var(--accent-primary);">production applications</span> with
          <span style="color: var(--accent-secondary);">NixOS</span> infrastructure and
          <span style="color: var(--accent-primary);">AI-assisted development</span>.
        </p>
        <div class="flex gap-4">
          <a href="#projects" class="retro-btn">View Projects</a>
          <a href="#contact" class="retro-btn retro-btn--outline">Get in Touch</a>
        </div>
        <div class="flex gap-6 pt-4 text-sm">
          <div><span class="text-2xl font-bold" style="color: var(--accent-primary);">7+</span><br><span style="color: var(--text-subtle);">Projects Shipped</span></div>
          <div><span class="text-2xl font-bold" style="color: var(--accent-primary);">4</span><br><span style="color: var(--text-subtle);">Host NixOS Cluster</span></div>
          <div><span class="text-2xl font-bold" style="color: var(--accent-primary);">Rust</span><br><span style="color: var(--text-subtle);">→ TypeScript → Python</span></div>
        </div>
      </div>

      <!-- Terminal -->
      <div data-animate="fade-up" data-delay="0.2" class="relative" style="z-index: 20;">
        <div id="term-wrapper" class="overflow-hidden relative rounded-lg" style="background: var(--bg-elevated); border: 1px solid var(--border-color); font-family: var(--font-mono, 'Fira Code', monospace);" role="region" aria-label="Interactive terminal">
          <div id="term-output" class="text-sm p-4 min-h-[300px] max-h-[400px] overflow-y-auto" style="font-family: inherit; line-height: 1.6;" role="log" aria-live="polite">
            <p style="color: var(--text-muted);">Welcome to the R256 knowledge database.</p>
            <p style="color: var(--text-muted);">Type <span style="color: var(--accent-secondary);">help</span> for commands.</p>
          </div>
          <div class="flex items-center px-4 py-2 border-t" style="border-color: var(--border-color); background: rgba(0,0,0,0.3); font-family: inherit;">
            <span style="color: var(--accent-success);" aria-hidden="true">❯</span>
            <span>&nbsp;</span>
            <input type="text" id="term-input" class="flex-grow bg-transparent border-none outline-none term-prompt" style="color: var(--text-primary); font-family: inherit; caret-color: var(--accent-secondary);" placeholder="type a command..." autocomplete="off" spellcheck="false" aria-label="Terminal command input" aria-describedby="term-instructions" />
          </div>
          <span id="term-instructions" class="sr-only">Type commands like help, list, or read to explore the database</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="px-6 py-12" aria-labelledby="projects-heading">
    <div class="max-w-6xl mx-auto">
      <div class="beat-indicator mb-6" aria-hidden="true"></div>
      <h2 id="projects-heading" class="retro-heading" style="font-size: var(--heading-size-1);">// Projects</h2>

      <div class="mb-10">
        <h3 class="text-sm font-bold uppercase tracking-wider mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full" style="background: var(--accent-primary);"></span>
          <span style="color: var(--accent-primary);">Client Work</span>
        </h3>
        <div data-stagger class="grid grid-cols-2 md:grid-cols-4 gap-3 auto-rows-[120px]" role="list">
          {projects.client.map((p) => (
            <a href={p.repo ? `https://github.com/reverb256/${p.repo}` : `https://github.com/reverb256`} target="_blank" rel="noopener noreferrer" data-stagger-item class={`bento-item group flex flex-col span-${p.span}`} role="listitem">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xl" aria-hidden="true">{p.icon}</span>
                <span class="text-[8px] px-1.5 py-0.5 rounded font-medium uppercase" style="color: var(--accent-primary);">{p.metric}</span>
              </div>
              <h3 class="text-sm font-bold group-hover:opacity-80 transition-opacity" style="color: var(--text-primary);">{p.title}</h3>
              <p class="text-[10px] flex-grow" style="color: var(--text-muted);">{p.desc}</p>
              <div class="flex gap-1 mt-auto">{p.tech.map(t => <span class="text-[8px] px-1.5 py-0.5 rounded" style="background: var(--bg-surface); color: var(--text-muted);">{t}</span>)}</div>
            </a>
          ))}
        </div>
      </div>

      <div class="mb-10">
        <h3 class="text-sm font-bold uppercase tracking-wider mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full" style="background: var(--accent-secondary);"></span>
          <span style="color: var(--accent-secondary);">Personal Projects</span>
        </h3>
        <div data-stagger class="grid grid-cols-2 md:grid-cols-4 gap-3 auto-rows-[120px]" role="list">
          {projects.personal.map((p) => (
            <a href={p.repo ? `https://github.com/reverb256/${p.repo}` : `https://github.com/reverb256`} target="_blank" rel="noopener noreferrer" data-stagger-item class={`bento-item group flex flex-col span-${p.span}`} role="listitem">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xl" aria-hidden="true">{p.icon}</span>
                <span class={`px-1.5 py-0.5 text-[8px] rounded font-medium uppercase ${p.status === 'live' ? 'badge-live' : 'badge-active'}`}>{p.status}</span>
              </div>
              <h3 class="text-sm font-bold group-hover:opacity-80 transition-opacity" style="color: var(--text-primary);">{p.title}</h3>
              <p class="text-[10px] flex-grow" style="color: var(--text-muted);">{p.desc}</p>
              <div class="flex gap-1 mt-auto">{p.tech.map(t => <span class="text-[8px] px-1.5 py-0.5 rounded" style="background: var(--bg-surface); color: var(--text-muted);">{t}</span>)}</div>
            </a>
          ))}
        </div>
      </div>

      <div class="mb-10">
        <h3 class="text-sm font-bold uppercase tracking-wider mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full" style="background: var(--accent-success);"></span>
          <span style="color: var(--accent-success);">Infrastructure</span>
        </h3>
        <div data-stagger class="grid grid-cols-2 md:grid-cols-4 gap-3 auto-rows-[120px]" role="list">
          {projects.infra.map((p) => (
            <a href={p.link || `https://github.com/reverb256`} target={p.link ? undefined : "_blank"} rel={p.link ? undefined : "noopener noreferrer"} data-stagger-item class={`bento-item group flex flex-col span-${p.span} border-2`} style="border-color: var(--accent-success);" role="listitem">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xl" aria-hidden="true">{p.icon}</span>
                <span class="text-[8px] px-1.5 py-0.5 rounded font-medium uppercase" style="background: var(--accent-success); color: var(--bg-primary);">{p.metric}</span>
              </div>
              <h3 class="text-sm font-bold group-hover:opacity-80 transition-opacity" style="color: var(--text-primary);">{p.title}</h3>
              <p class="text-[10px] flex-grow" style="color: var(--text-muted);">{p.desc}</p>
              <div class="flex gap-1 mt-auto">{p.tech.map(t => <span class="text-[8px] px-1.5 py-0.5 rounded" style="background: var(--bg-surface); color: var(--text-muted);">{t}</span>)}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="px-6 py-12" aria-labelledby="about-heading">
    <div class="max-w-6xl mx-auto">
      <div class="beat-indicator mb-6" aria-hidden="true"></div>
      <h2 id="about-heading" class="retro-heading" style="font-size: var(--heading-size-1);">// About</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <article class="retro-card" style="padding: 1.5rem;">
          <h3 class="retro-subheading" style="font-size: var(--heading-size-2); margin-bottom: 1rem;">My Story</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
            Spent <span style="color: var(--accent-primary);">15 years in food service</span> learning the value of hard work, teamwork, and showing up every day. Meanwhile, always curious about computers — <span style="color: var(--accent-secondary);">20 years of tinkering, researching, and dabbling with Linux</span> on the side.
          </p>
          <p class="text-sm leading-relaxed mt-3" style="color: var(--text-secondary);">
            Fully committed to <span style="color: var(--accent-primary);">NixOS</span> for system configuration. Built a <span style="color: var(--accent-secondary);">4-host mining cluster</span> with Colmena deployment, currently migrating to Kubernetes.
          </p>
          <p class="text-sm leading-relaxed mt-3" style="color: var(--text-secondary);">
            <strong style="color: var(--text-primary);">Current focus:</strong> Building privacy-first AI tools, Web3 authentication systems, and local-first applications.
          </p>
        </article>
        <article class="retro-card" style="padding: 1.5rem;">
          <h3 class="retro-subheading" style="font-size: var(--heading-size-2); margin-bottom: 1rem;">What I Bring</h3>
          <div class="flex flex-wrap gap-2">
            {["Work ethic", "Eager to learn", "Team player", "Problem solver", "Patient", "Reliable"].map(f => <span class="text-xs px-3 py-1.5 rounded-full cursor-default" style="border: 1px solid var(--border-color); color: var(--text-muted);">{f}</span>)}
          </div>
          <h3 class="retro-subheading" style="font-size: var(--heading-size-2); margin-bottom: 1rem; margin-top: 1.5rem;">Tech Stack</h3>
          <div class="flex flex-wrap gap-2">
            {skills.map(s => <span class="text-xs px-3 py-1 rounded cursor-default" style="background: var(--bg-surface); color: var(--text-secondary);">{s}</span>)}
          </div>
          <div class="mt-4 pt-4 text-xs space-y-1" style="border-top: 1px solid var(--border-color); color: var(--text-muted);">
            <div>OS: NixOS (4-host cluster + Colmena)</div>
            <div>Method: AI-assisted development (Claude Code)</div>
            <div>Infrastructure: Kubernetes migration in progress</div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="px-6 py-12" aria-labelledby="contact-heading">
    <div class="max-w-6xl mx-auto">
      <div class="beat-indicator mb-6" aria-hidden="true"></div>
      <h2 id="contact-heading" class="retro-heading" style="font-size: var(--heading-size-1);">// Contact</h2>
      <div class="retro-card flex flex-wrap items-center justify-between gap-4" style="padding: 1.5rem;">
        <div>
          <p class="text-sm mb-4" style="color: var(--text-secondary);">Open to junior roles, internships, or just chatting about tech.</p>
          <div class="flex gap-3">
            <a href="mailto:contact@reverb256.dev" class="retro-btn text-sm">Email</a>
            <a href="https://github.com/reverb256" target="_blank" rel="noopener noreferrer" class="retro-btn retro-btn--outline text-sm">GitHub</a>
          </div>
        </div>
        <div class="text-right text-xs" style="color: var(--text-subtle);">
          <address class="not-italic">Winnipeg, Canada</address>
          <div>Open to remote work</div>
        </div>
      </div>
    </div>
  </section>

  <footer class="px-6 py-4" style="border-top: 1px solid var(--border-color);">
    <div class="max-w-6xl mx-auto flex items-center justify-between text-[10px]" style="color: var(--text-subtle);">
      <span>© 2026 Reverb256</span>
      <span>Astro + 16 Themes + NixOS</span>
      <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full animate-pulse" style="background: var(--accent-success);" aria-hidden="true"></span> All Systems Operational</span>
    </div>
  </footer>
</Layout>

<script define:vars={{ db }}>
import DOMPurify from 'dompurify';
  const output = document.getElementById('term-output');
  const input = document.getElementById('term-input');

  const autocompleteSuggestions = {
    'help': 'help', 'list': 'list', 'ls': 'ls', 'read': 'read ',
    'whoami': 'whoami', 'random': 'random', 'search': 'search ',
    'clear': 'clear', 'projects': 'projects', 'cluster': 'cluster',
    'glossary': 'glossary', 'about': 'about'
  };

  let currentSuggestion = '';

  function print(text, style) {
    const line = document.createElement('div');
    line.style.cssText = (style || 'color: var(--accent-success);') + ' margin-top: 0.25rem;';
    line.innerHTML = DOMPurify.sanitize(text);
    output.appendChild(line);
    output.scrollTop = output.scrollHeight;
    line.style.animation = 'glitch 0.1s ease-out';
    setTimeout(() => line.style.animation = '', 100);
  }

  window.execCmd = async function(cmd) {
    const parts = cmd.trim().toLowerCase().split(/\s+/);
    const command = parts[0];
    const arg = parts.slice(1).join('_').toUpperCase();

    print(`<span style="color: var(--text-muted);">> ${cmd}</span>`);
    await new Promise(r => setTimeout(r, 100));

    switch(command) {
      case 'help':
        print(`<span style="color: var(--accent-secondary);">AVAILABLE COMMANDS:</span>
  <span style="color: var(--text-primary);">help</span>      - Display help
  <span style="color: var(--text-primary);">list</span>      - List all subjects
  <span style="color: var(--text-primary);">ls</span>        - Alias for list
  <span style="color: var(--text-primary);">read [ID]</span> - Read subject file
  <span style="color: var(--text-primary);">random</span>    - Random subject
  <span style="color: var(--text-primary);">search [q]</span> - Search database
  <span style="color: var(--text-primary);">clear</span>     - Clear terminal
  <span style="color: var(--text-primary);">projects</span>  - Recent projects
  <span style="color: var(--text-primary);">cluster</span>   - NixOS cluster info
  <span style="color: var(--text-primary);">about</span>     - About system`);
        break;

      case 'ls':
      case 'list':
        print(`<span style="color: var(--accent-secondary);">DATABASE SUBJECTS</span>`);
        db.subjects.forEach(s => {
          const color = s.classification === 'TOP SECRET' ? 'var(--accent-error)' :
                       s.classification === 'RESTRICTED' ? 'var(--accent-warning)' : 'var(--accent-success)';
          print(`  <span style="color: var(--text-primary);">${s.id}</span> - ${s.title} [<span style="color: ${color};">${s.classification}</span>]`);
        });
        break;

      case 'whoami':
        print(`<span style="color: var(--accent-secondary);">USER: r256</span>
<span style="color: var(--text-muted);">Role: Administrator</span>
<span style="color: var(--text-muted);">Clearance: TOP SECRET</span>
<span style="color: var(--accent-success);">System: NixOS/Zephyr</span>`);
        break;

      case 'read':
        if (!arg) { print(`<span style="color: var(--accent-error);">ERROR: Specify ID. Usage: read [ID]</span>`); break; }
        const subject = db.subjects.find(s => s.id === arg);
        if (!subject) { print(`<span style="color: var(--accent-error);">ERROR: '${arg}' not found</span>`); break; }
        const clr = subject.classification === 'TOP SECRET' ? 'var(--accent-error)' : 'var(--accent-secondary)';
        print(`<span style="color: ${clr};">SUBJECT: ${subject.title}</span>`);
        print(`<span style="color: var(--text-muted);">ID: ${subject.id} | ${subject.category}</span>`);
        print(`<span style="color: ${clr};">CLASS: ${subject.classification}</span>`);
        subject.content.forEach(line => print(`  ${line}`));
        break;

      case 'random': execCmd(`read ${db.subjects[Math.floor(Math.random() * db.subjects.length)].id}`); break;

      case 'search':
        if (!arg) { print(`<span style="color: var(--accent-warning);">Usage: search [query]</span>`); break; }
        const results = db.subjects.filter(s => s.title.toLowerCase().includes(arg.toLowerCase()) || s.content.some(c => c.toLowerCase().includes(arg.toLowerCase())));
        if (results.length === 0) { print(`<span style="color: var(--accent-warning);">No results for '${arg}'</span>`); }
        else { print(`<span style="color: var(--accent-secondary);">Found ${results.length} result(s):</span>`); results.forEach(s => print(`  <span style="color: var(--text-primary);">${s.id}</span> - ${s.title}`)); }
        break;

      case 'clear':
        output.innerHTML = DOMPurify.sanitize(`<pre style="color: var(--accent-success); opacity: 0.8; font-size: 0.75rem;">R256 TERMINAL v2.56</pre><p style="margin-top: 0.75rem; color: var(--text-muted);">Terminal cleared. Type <span style="color: var(--accent-success);">help</span>.</p>`);
        break;

      case 'projects': execCmd('read PROJ_001'); break;
      case 'cluster': execCmd('read CLUSTER_001'); break;

      case 'about':
        print(`<span style="color: var(--accent-secondary);">REVERB256 DATABASE TERMINAL</span>
Version: 2.56.1
Build: 2026.05.09
Engine: Astro + 16 Retro Themes
Purpose: Knowledge repository`);
        break;

      case 'matrix':
        print(`<span style="color: var(--accent-success);">Wake up, Neo...</span>`);
        print(`<span style="color: var(--accent-success);">The Matrix has you...</span>`);
        break;

      default:
        print(`<span style="color: var(--accent-error);">UNKNOWN: '${command}'</span>`);
        print(`<span style="color: var(--text-muted);">Type 'help' for commands.</span>`);
    }
  };

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const cmd = input.value.trim();
      if (cmd) { execCmd(cmd); input.value = ''; const s = document.getElementById('autocomplete-suggestion'); if (s) s.remove(); }
    } else if (e.key === 'Tab') {
      e.preventDefault();
      if (currentSuggestion && input.value.startsWith(currentSuggestion)) { input.value = currentSuggestion; const s = document.getElementById('autocomplete-suggestion'); if (s) s.remove(); }
    }
  });

  document.getElementById('term-wrapper').addEventListener('click', () => input.focus());

  setTimeout(() => {
    [{ t: '> System initialized', c: 'var(--accent-success)' }, { t: `> Database loaded: ${db.subjects.length} subjects`, c: 'var(--accent-success)' }, { t: `> Classification levels: ${db.classifications.join(', ')}`, c: 'var(--accent-success)' }].forEach((l, i) => {
      setTimeout(() => { const el = document.createElement('div'); el.style.cssText = `color: ${l.c}; margin-top: 0.5rem;`; el.textContent = l.t; output.appendChild(el); output.scrollTop = output.scrollHeight; }, i * 150);
    });
  }, 500);
</script>

<style>
  @keyframes glitch {
    0% { transform: translateX(0); filter: hue-rotate(0deg); }
    25% { transform: translateX(-2px); filter: hue-rotate(90deg); }
    50% { transform: translateX(2px); filter: hue-rotate(180deg); }
    75% { transform: translateX(-1px); filter: hue-rotate(270deg); }
    100% { transform: translateX(0); filter: hue-rotate(360deg); }
  }

  #term-wrapper { box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4); transition: box-shadow 0.3s ease; }
  #term-wrapper:hover { box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5); }
  #term-input::placeholder { color: var(--text-subtle); }
  #term-output { font-size: clamp(0.875rem, 1.2vw, 1rem); }
  #term-input { font-size: clamp(0.875rem, 1.2vw, 1rem); }
</style>
