---
// Dynamic theme preview page — shows one theme fullscreen
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [
    { params: { id: "ddr-3rd" } },
    { params: { id: "ddr-max" } },
    { params: { id: "ddr-extreme" } },
    { params: { id: "bm-5th" } },
    { params: { id: "iidx-7th" } },
    { params: { id: "iidx-10th" } },
    { params: { id: "iidx-gold" } },
    { params: { id: "iidx-pendual" } },
    { params: { id: "iidx-resident" } },
    { params: { id: "n64" } },
    { params: { id: "gamecube" } },
    { params: { id: "ds" } },
    { params: { id: "win95" } },
    { params: { id: "winxp" } },
    { params: { id: "dos-games" } },
    { params: { id: "linux-wm" } },
  ];
}

const { id } = Astro.params;

const themes: Record<string, { name: string; subtitle: string; franchise: string; features: string[] }> = {
  "ddr-3rd": {
    name: "DDR 3rd Mix",
    subtitle: "Jukebox-era neon green on black",
    franchise: "DDR",
    features: ["Vertical scrolling list nav", "Neon green + pink + blue", "Anton display font", "2px border-radius"],
  },
  "ddr-max": {
    name: "DDR MAX",
    subtitle: "Song wheel on right side, dark blue-black",
    franchise: "DDR",
    features: ["Two-panel grid layout", "Green primary + blue secondary", "Song wheel sidebar (320px)", "Horizontal scan accent"],
  },
  "ddr-extreme": {
    name: "DDR Extreme",
    subtitle: "Green vortex, metallic yellow — default theme",
    franchise: "DDR",
    features: ["Horizontal scroll snap nav", "Metallic yellow + cyan", "Cards with top gradient bar", "Active items scale + glow"],
  },
  "bm-5th": {
    name: "beatmania 5th Mix",
    subtitle: "5-key DJ cabinet, orange on dark",
    franchise: "IIDX",
    features: ["Auto-fill grid nav (record crate)", "Orange primary (#ff6600)", "Oswald display font", "Retro button border glow"],
  },
  "iidx-7th": {
    name: "IIDX 7th Style",
    subtitle: "Blue primary, red ANOTHER accent",
    franchise: "IIDX",
    features: ["Vertical nav with border-left indicator", "Blue (#00aaff) + red (#ff1744)", "Orbitron display font", "Scroll snap horizontal cards"],
  },
  "iidx-10th": {
    name: "IIDX 10th Style",
    subtitle: "Purple/magenta neon, dark purple palette",
    franchise: "IIDX",
    features: ["Auto-fill grid nav", "Purple (#e040fb) + cyan (#00e5ff)", "Orbitron display font", "Active items get magenta glow"],
  },
  "iidx-gold": {
    name: "IIDX GOLD",
    subtitle: "Gold/amber, warm dark background",
    franchise: "IIDX",
    features: ["Grid nav layout", "Gold (#ffc107) primary", "Orbitron display font", "Active items get golden box-shadow"],
  },
  "iidx-pendual": {
    name: "IIDX PENDUAL",
    subtitle: "Dual mode: Future (cool blue) / Past (warm sepia)",
    franchise: "IIDX",
    features: ["Dual-column nav grid", "Future: #448aff / Past: #ff8a65", "Orbitron display font", "Toggle via data-pendual-mode attribute"],
  },
  "iidx-resident": {
    name: "IIDX RESIDENT",
    subtitle: "Modern minimal, monochrome + green accent",
    franchise: "IIDX",
    features: ["Modern grid nav", "Green accent (#00e676)", "Inter font (no display font)", "6px border-radius — modern feel"],
  },
  n64: {
    name: "Nintendo 64",
    subtitle: "Dark purple, controller button palette",
    franchise: "Nintendo",
    features: ["Round nav items (24px radius)", "Blue (#3333FF) + green (#45D043)", "Bebas Neue display font", "Active items scale + glow"],
  },
  gamecube: {
    name: "GameCube",
    subtitle: "Indigo primary, spice orange secondary",
    franchise: "Nintendo",
    features: ["Cube-spin grid nav", "Indigo (#4A3A92) + orange (#E8621C)", "Bebas Neue display font", "12px border-radius", "Active items get orange border glow"],
  },
  ds: {
    name: "Nintendo DS",
    subtitle: "Light theme — white/light gray, top-screen nav",
    franchise: "Nintendo",
    features: ["Light theme (color-scheme: light)", "Top-screen flex-wrap nav", "Clean minimal aesthetic", "DS-blue accent (#0066cc)"],
  },
  win95: {
    name: "Windows 95",
    subtitle: "Teal desktop, 3D beveled chrome",
    franchise: "Computer",
    features: ["3D beveled box-shadow buttons", "Taskbar nav at bottom", "Zero border-radius", "Segoe UI font", "Teal (#008080) desktop"],
  },
  winxp: {
    name: "Windows XP",
    subtitle: "Luna blue, Bliss gradient, window chrome",
    franchise: "Computer",
    features: ["XP title bar gradient on cards", "Luna taskbar nav", "Green Start button metaphor", "Segoe UI font", "4px border-radius"],
  },
  "dos-games": {
    name: "DOS Games",
    subtitle: "EGA 16-color, C&C sidebar, pixel fonts",
    franchise: "Computer",
    features: ["Press Start 2P + VT323 pixel fonts", "Green (#00ff00) on black", "C&C sidebar layout", "EGA 16-color palette defined", "Zero border-radius"],
  },
  "linux-wm": {
    name: "Linux Tiling WM",
    subtitle: "Gruvbox Dark + i3/bspwm",
    franchise: "Computer",
    features: ["JetBrains Mono for everything", "Tiling grid layout (8px gaps)", "Sharp corners — zero border-radius", "Green (#689d6a) focused border", "Monospace-scaled heading sizes"],
  },
};

const theme = themes[id as string];

if (!theme) {
  return Astro.redirect("/themes-preview");
}
---

<Layout title={`Theme: ${theme.name}`}>
  <div style="min-height: 100vh; padding: 2rem;" data-theme={id}>
    <!-- Back link -->
    <a href="/themes-preview" style="font-family: 'Fira Code', monospace; font-size: 0.75rem; text-decoration: none; color: var(--text-muted); display: inline-flex; align-items: center; gap: 4px; margin-bottom: 2rem;">
      ← All Themes
    </a>

    <!-- Theme heading -->
    <div style="margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-primary);">
      {theme.franchise}
    </div>
    <h1 class="retro-heading" style="font-size: var(--heading-size-hero, clamp(2rem, 5vw, 4rem)); margin-bottom: 0.5rem;">
      {theme.name}
    </h1>
    <p class="retro-subheading" style="font-size: var(--heading-size-1, clamp(1.5rem, 3.5vw, 2.5rem)); margin-bottom: 2rem;">
      {theme.subtitle}
    </p>

    <!-- Color palette swatches -->
    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Fira Code', monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 1rem;">
        Color Palette
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px;">
        {["bg-primary", "bg-elevated", "bg-surface", "accent-primary", "accent-secondary", "accent-success", "accent-error", "accent-warning", "text-primary", "text-secondary", "text-muted"].map((token) => (
          <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
            <div style={`width: 100%; aspect-ratio: 2/1; background: var(--${token}); border-radius: var(--radius-theme, 4px); border: 1px solid var(--border-color, rgba(255,255,255,0.1));`}></div>
            <span style={`font-family: 'Fira Code', monospace; font-size: 0.55rem; color: var(--text-muted); text-align: center;`}>{token}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography scale -->
    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Fira Code', monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 1rem;">
        Typography Scale
      </h2>
      <div class="retro-card" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <h1 class="retro-heading" style="font-size: var(--heading-size-hero, clamp(2rem, 5vw, 4rem)); margin: 0;">
          Hero Heading
        </h1>
        <h2 class="retro-heading" style="font-size: var(--heading-size-1, clamp(1.5rem, 3.5vw, 2.5rem)); margin: 0;">
          H1 Heading
        </h2>
        <h3 class="retro-subheading" style="font-size: var(--heading-size-2, clamp(1.1rem, 2vw, 1.5rem)); margin: 0;">
          H2 Subheading
        </h3>
        <p style="font-family: var(--font-body, 'Inter', sans-serif); color: var(--text-secondary);">
          Body text — the quick brown fox jumps over the lazy dog. 0123456789
        </p>
        <p style="font-family: var(--font-mono, 'Fira Code', monospace); color: var(--text-muted); font-size: 0.85rem;">
          Mono text — const answer = 42;
        </p>
      </div>
    </section>

    <!-- Buttons -->
    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Fira Code', monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 1rem;">
        Buttons
      </h2>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
        <button class="retro-btn">Primary</button>
        <button class="retro-btn retro-btn--outline">Outline</button>
      </div>
    </section>

    <!-- Cards -->
    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Fira Code', monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 1rem;">
        Cards
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
        <div class="retro-card" style="padding: 1rem;">
          <h3 class="retro-subheading" style="font-size: var(--heading-size-2, clamp(1.1rem, 2vw, 1.5rem)); margin-bottom: 0.5rem;">
            Card Title
          </h3>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            A retro-themed card with theme-aware colors and borders.
          </p>
          <div style="margin-top: 0.75rem; display: flex; gap: 6px;">
            <span style="font-size: 0.6rem; padding: 2px 8px; background: var(--accent-primary); color: var(--bg-primary); font-weight: 700; border-radius: var(--radius-theme, 2px);">
              Tag
            </span>
            <span style="font-size: 0.6rem; padding: 2px 8px; background: var(--accent-secondary); color: var(--bg-primary); font-weight: 700; border-radius: var(--radius-theme, 2px);">
              Another
            </span>
          </div>
        </div>
        <div class="retro-card" style="padding: 1rem;">
          <h3 class="retro-subheading" style="font-size: var(--heading-size-2, clamp(1.1rem, 2vw, 1.5rem)); margin-bottom: 0.5rem;">
            Another Card
          </h3>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            Every color, radius, and shadow comes from CSS custom properties set by the theme.
          </p>
          <div style="margin-top: 0.75rem; display: flex; gap: 6px;">
            <span style="font-size: 0.6rem; padding: 2px 8px; border: 1px solid var(--accent-primary); color: var(--accent-primary); border-radius: var(--radius-theme, 2px);">
              Outline Tag
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features list -->
    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Fira Code', monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 1rem;">
        Theme Features
      </h2>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
        {theme.features.map((f) => (
          <li style="font-family: 'Fira Code', monospace; font-size: 0.75rem; color: var(--text-secondary); display: flex; gap: 8px; align-items: baseline;">
            <span style="color: var(--accent-primary);">▸</span>
            {f}
          </li>
        ))}
      </ul>
    </section>

    <!-- Back link -->
    <div style="padding: 3rem 0 1rem;">
      <a href="/themes-preview" class="retro-btn retro-btn--outline">
        ← Back to All Themes
      </a>
    </div>
  </div>
</Layout>
