---
// Layout.astro - Declarative base layout with GSAP + SEO

import Header from "../components/Header.astro";

// Self-hosted fonts (no external CDN) — regression: gstatic preload URLs 404'd (2026-09-22)
import "@fontsource/bebas-neue/400.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/500.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
}

const {
  title,
  description = "Software developer portfolio | Reverb256 - Building with Rust, TypeScript, and self-hosted AI",
  image = "/og-image.png",
  canonical,
  type = "website"
} = Astro.props;

// Generate full title
const fullTitle = `${title} | Reverb256`;

// Generate canonical URL if not provided
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;

// Open Graph image URL (absolute)
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


    <!-- Critical for color consistency: declare color space support -->
    <meta name="color-scheme" content="dark" />

    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Reverb256" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_CA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are self-hosted via @fontsource (imported in frontmatter; no external CDN) -->

    <title>{fullTitle}</title>

    <!-- Structured Data - Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Reverb256",
      "url": "https://reverb256.dev",
      "sameAs": [
        "https://github.com/reverb256"
      ],
      "jobTitle": "AI Systems Orchestrator & Private Infrastructure Architect",
      "knowsAbout": [
        "Rust Programming",
        "TypeScript",
        "NixOS",
        "Kubernetes",
        "AI/ML",
        "Web Development"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Independent"
      }
    })}></script>

    <!-- Structured Data - WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Reverb256",
      "url": "https://reverb256.dev/",
      "description": "AI Systems Orchestrator building sovereign, self-hosted AI infrastructure.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://reverb256.dev/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })}></script>
  </head>
  <body style="min-height: 100vh; margin: 0; padding: 0; color: var(--text-secondary); font-family: system-ui, -apple-system, sans-serif; overflow-x: hidden;">
    <!-- Background gradient — solid terminal colors, no P3/gamut stretching -->
    <div id="bg-gradient" style="position: fixed; inset: 0; background: linear-gradient(to bottom right, var(--bg-primary) 0%, var(--base01) 100%); z-index: -20;"></div>

    <!-- Subtle animated glows — base24 palette, CSS-native -->
    <div id="glow-1" style="position: fixed; top: -100px; left: 10%; width: 400px; height: 300px; background: radial-gradient(ellipse, rgba(167, 139, 250, 0.06) 0%, transparent 70%); z-index: -15; pointer-events: none; will-change: transform;"></div>
    <div id="glow-2" style="position: fixed; bottom: -50px; right: 5%; width: 300px; height: 250px; background: radial-gradient(ellipse, rgba(78, 205, 196, 0.05) 0%, transparent 70%); z-index: -15; pointer-events: none; will-change: transform;"></div>

    <!-- Particles canvas -->
    <canvas id="particles" style="position: fixed; inset: 0; z-index: -10; pointer-events: none;"></canvas>

    <!-- CRT scanline overlay -->
    <div class="crt-overlay" aria-hidden="true"></div>

    <!-- Floating decorative code fragments -->
    <div class="ghost-code" style="position: fixed; top: 15%; right: 3%; opacity: 0.04; font-family: 'Fira Code', monospace; font-size: 11px; color: var(--base0D); pointer-events: none; z-index: 1; user-select: none;" aria-hidden="true">
    &gt; init_sequence()
  </div>
    <div class="ghost-code" style="position: fixed; bottom: 25%; left: 2%; opacity: 0.03; font-family: 'Fira Code', monospace; font-size: 10px; color: var(--base09); pointer-events: none; z-index: 1; user-select: none;" aria-hidden="true">
    const cluster = new Cluster();
  </div>
    <div class="ghost-code" style="position: fixed; top: 45%; left: 5%; opacity: 0.02; font-family: 'Fira Code', monospace; font-size: 9px; color: var(--base0B); pointer-events: none; z-index: 1; user-select: none;" aria-hidden="true">
    &lt;Rust/&gt;
  </div>


    <!-- Header Navigation -->
    <Header />

    <!-- Main content -->
    <main id="main-content" class="main-content">
      <slot />
    </main>

    <!-- ════════════════════════════════════════════
         TERMINAL SCRATCHPAD — niri-style scratchpad
         A floating terminal available on every page.
         Toggle via the $_ button (bottom-right) or
         Ctrl+` shortcut.
         ════════════════════════════════════════════ -->

    <!-- Floating toggle button -->
    <button
      id="scratch-toggle"
      class="fixed bottom-4 right-4 z-[9999] w-10 h-10 flex items-center justify-center text-sm font-bold cursor-pointer select-none"
      style="background: var(--base01); border: 1px solid var(--border-default); color: var(--base0B); font-family: 'Fira Code', monospace;"
      aria-label="Toggle terminal scratchpad"
      title="Toggle scratchpad (Ctrl+`)"
    >
      <span class="text-xs leading-none">$_</span>
    </button>

    <!-- Scratchpad panel -->
    <div
      id="scratch-panel"
      class="fixed bottom-0 right-0 z-[9998] w-full md:w-[500px] transition-transform duration-300"
      style="background: var(--base00); border: 1px solid var(--border-default); border-bottom: none; font-family: 'Fira Code', 'JetBrains Mono', monospace; transform: translateY(100%); max-height: 60vh;"
      role="region"
      aria-label="Terminal scratchpad"
      aria-hidden="true"
    >
      <!-- Titlebar — draggable feel, shows context -->
      <div class="flex items-center justify-between px-3 py-1.5" style="background: var(--base01); border-bottom: 1px solid var(--border-default); cursor: grab;">
        <span class="font-mono text-[10px] text-[var(--base04)]">scratchpad ▸ j_kro@zephyr</span>
        <div class="flex gap-1.5">
          <button id="scratch-minimize" class="w-3.5 h-3.5 flex items-center justify-center text-[7px] border" style="border-color: var(--border-default); color: var(--base04); background: var(--base01);" aria-label="Minimize scratchpad">_</button>
          <button id="scratch-close" class="w-3.5 h-3.5 flex items-center justify-center text-[7px] border" style="border-color: var(--border-default); color: var(--base08); background: var(--base01);" aria-label="Close scratchpad">✕</button>
        </div>
      </div>
      <!-- Output -->
      <div
        id="scratch-output"
        class="text-xs p-3 overflow-y-auto"
        style="font-family: inherit; line-height: 1.5; max-height: calc(60vh - 34px); min-height: 120px;"
        role="log"
        aria-live="polite"
      >
        <div style="color: var(--base05);">Scratchpad ready. Type <span style="color: var(--base0D);">help</span> for commands.</div>
      </div>
      <!-- Input -->
      <div class="flex items-center px-3 py-1.5 border-t" style="border-color: var(--base02); background: rgba(0,0,0,0.3);">
        <span style="color: var(--base0B); font-size: 11px;" aria-hidden="true">❯</span>
        <span>&nbsp;</span>
        <input
          type="text"
          id="scratch-input"
          class="flex-grow bg-transparent border-none outline-none"
          style="color: var(--base06); font-family: inherit; font-size: 11px; caret-color: var(--base0D);"
          placeholder="type a command..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Scratchpad command input"
        />
      </div>
    </div>

    <!-- Console Easter Egg -->
    <script is:inline>
      // Devtools greeting — only shows when someone opens the console
      const style = [
        'color: var(--base0B); font-family: "Fira Code", monospace; font-size: 11px;',
        'color: var(--base09); font-family: "Fira Code", monospace; font-size: 10px;',
        'color: var(--base05); font-family: "Fira Code", monospace; font-size: 10px;',
        'color: var(--base0D); font-family: "Fira Code", monospace; font-size: 10px;',
        'color: var(--base05); font-family: "Fira Code", monospace; font-size: 10px;',
        'color: var(--base0B); font-family: "Fira Code", monospace; font-size: 10px;',
      ];
      const ascii = [
        "%c   ▗▄   ▗▄ ▄▖             ",
        "%c  ▄▄█▄▄▄██▛ ▃              ",
        "%c    ▟▛    ▜▃▟               ",
        "%c █      █                   ",
        "%c  ▷▛▙    ▟▛                  ",
        "%c  ▟██▀▀▀██▀▀                ",
        "%c   ▝▀ ▀▘   ▀▘               ",
      ];
      const msgs = [];
      for (let i = 0; i < ascii.length; i++) {
        msgs.push(ascii[i], style[i % style.length]);
      }
      msgs.push("");
      msgs.push("%c┌─────────────────────────────────────┐");
      msgs.push("%c│  Welcome, operator.                  │");
      msgs.push("%c│  This site is served from a 5-node   │");
      msgs.push("%c│  K3s cluster in Winnipeg.            │");
      msgs.push("%c│                                     │");
      msgs.push("%c│  Type 'help' for available commands. │");
      msgs.push("%c│  This console is being watched.      │");
      msgs.push("%c└─────────────────────────────────────┘");
      
      msgs.push("", "%c  Zero cloud spend. No compromise.", "");
      
      // Apply alternating styles
      const msgStyles = [
        "color: var(--base04); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base06); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base05); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base05); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base05); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base0D); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base05); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base04); font-family: 'Fira Code', monospace; font-size: 11px;",
        "color: var(--base0B); font-family: 'Fira Code', monospace; font-size: 11px; font-style: italic;",
        "",
      ];
      
      // Hide console greeting initially — show only if console is opened
      let shown = false;
      const detectDevTools = () => {
        if (shown) return;
        const widthThreshold = window.outerWidth - window.innerWidth > 160;
        const heightThreshold = window.outerHeight - window.innerHeight > 160;
        if (widthThreshold || heightThreshold) {
          shown = true;
          clearInterval(intervalId);
          msgs.forEach((m, i) => {
            if (m.startsWith("%c")) {
              console.log(m, msgStyles[i] || "color: var(--base05);");
            } else {
              console.log(m);
            }
          });
          // Register 'help' command handler
          window.__consoleHelp = () => {
            console.log("%cAvailable commands:", "color: var(--base0D); font-weight: bold;");
            console.log("%c  ╰─► neofetch   — Show system info", "color: var(--base0B);");
            console.log("%c  ╰─► status     — Cluster status", "color: var(--base0B);");
            console.log("%c  ╰─► projects   — Active projects", "color: var(--base0B);");
            console.log("%c  ╰─► clear      — Clear console", "color: var(--base0B);");
            console.log("%cTip: Try typing neofetch or status in the console.", "color: var(--base05); font-style: italic;");
          };
        }
      };
      
      // Check periodically — stops after detection
      const intervalId = setInterval(detectDevTools, 1000);
      detectDevTools();
      
      // Console command handlers
      const commands = {
        help: () => window.__consoleHelp?.(),
        neofetch: () => {
          console.log("%c       ▗▄   ▗▄ ▄▖                  j_kro@reverb256.ca", "color: var(--base0B); font-family: 'Fira Code';");
          console.log("%c      ▄▄█▄▄▄██▛ ▃                 ----------------------", "color: var(--base09); font-family: 'Fira Code';");
          console.log("%c        ▟▛    ▜▃▟                  OS: Astro 7.0.9", "color: var(--base05); font-family: 'Fira Code';");
          console.log("%c     █      █                       Kernel: TypeScript 5.x", "color: var(--base0D); font-family: 'Fira Code';");
          console.log("%c      ▷▛▙    ▟▛                     Uptime: ~3h (last deploy)", "color: var(--base05); font-family: 'Fira Code';");
          console.log("%c      ▟██▀▀▀██▀▀                   Shell: Fira Code 1.0", "color: var(--base0B); font-family: 'Fira Code';");
          console.log("%c       ▝▀ ▀▘   ▀▘                  WM: niri 26.04", "color: var(--base05); font-family: 'Fira Code';");
          console.log("%c  ● ● ● ● ● ● ● ●                Packages: 53 (public repos)", "color: var(--base06); font-family: 'Fira Code';");
        },
        status: () => {
          console.log("%c● reverb256.service — Portfolio Site", "color: var(--base0B); font-weight: bold;");
          console.log("%c   Loaded: loaded (/nix/store/.../reverb256.service; enabled)", "color: var(--base05);");
          console.log("%c   Active: active (running)", "color: var(--base0B);");
          console.log("%c   Status: \"Serving from Winnipeg. Zero cloud spend.\"", "color: var(--base05);");
        },
      };
      
      // Register global handlers so they work when typed in devtools console
      window.help = () => commands.help();
      window.neofetch = () => commands.neofetch();
      window.status = () => commands.status();
    </script>

    <!-- ════════════════════════════════════════════
         SCRATCHPAD TERMINAL — persistent shell
         ════════════════════════════════════════════ -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('scratch-toggle');
        const panel = document.getElementById('scratch-panel');
        const output = document.getElementById('scratch-output');
        const input = document.getElementById('scratch-input');
        const minimizeBtn = document.getElementById('scratch-minimize');
        const closeBtn = document.getElementById('scratch-close');

        if (!toggle || !panel || !output || !input) return;

        let isOpen = false;

        // ----------------------------------------------------------------
        // Toggle
        // ----------------------------------------------------------------

        function open() {
          isOpen = true;
          panel.style.transform = 'translateY(0)';
          panel.setAttribute('aria-hidden', 'false');
          toggle.style.borderColor = 'var(--accent-niri)';
          toggle.style.color = 'var(--accent-niri)';
          setTimeout(() => input.focus(), 150);
        }

        function close() {
          isOpen = false;
          panel.style.transform = 'translateY(100%)';
          panel.setAttribute('aria-hidden', 'true');
          toggle.style.borderColor = 'var(--border-default)';
          toggle.style.color = 'var(--base0B)';
        }

        function toggleScratch() {
          if (isOpen) close();
          else open();
        }

        toggle.addEventListener('click', toggleScratch);
        closeBtn?.addEventListener('click', close);
        minimizeBtn?.addEventListener('click', close);

        // ----------------------------------------------------------------
        // Keyboard shortcut: Ctrl+`
        // ----------------------------------------------------------------

        document.addEventListener('keydown', (e) => {
          if (e.ctrlKey && e.key === '`') {
            e.preventDefault();
            toggleScratch();
          }
        });

        // Close on Escape when open
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen) {
            close();
            e.preventDefault();
          }
        });

        // ----------------------------------------------------------------
        // Command handlers
        // ----------------------------------------------------------------

        function print(text, style) {
          const line = document.createElement('div');
          line.style.cssText = (style || 'color: var(--base0B);') + ' margin-top: 0.15rem;';
          line.textContent = text;
          output.appendChild(line);
          output.scrollTop = output.scrollHeight;
        }

        function printFormatted(html) {
          const line = document.createElement('div');
          line.style.cssText = 'margin-top: 0.15rem;';
          line.innerHTML = html;
          output.appendChild(line);
          output.scrollTop = output.scrollHeight;
        }

        function clearOutput() {
          output.innerHTML = '<div style="color: var(--base05); margin-top: 0;">Scratchpad ready. Type <span style="color: var(--base0D);">help</span> for commands.</div>';
        }

        async function execScratchCmd(cmd) {
          const parts = cmd.trim().toLowerCase().split(/\s+/);
          const command = parts[0];
          const args = parts.slice(1);

          print(`> ${cmd}`, 'color: var(--base05);');
          await new Promise(r => setTimeout(r, 50));

          switch (command) {
            case 'help':
              printFormatted(`<span style="color: var(--base0D);">COMMANDS:</span><br />
  <span style="color: var(--base06);">help</span>       &mdash; Show this help<br />
  <span style="color: var(--base06);">clear</span>      &mdash; Clear terminal<br />
  <span style="color: var(--base06);">whoami</span>     &mdash; Show user info<br />
  <span style="color: var(--base06);">neofetch</span>   &mdash; System info<br />
  <span style="color: var(--base06);">status</span>     &mdash; Cluster status<br />
  <span style="color: var(--base06);">banner</span>     &mdash; Show NixOS ASCII<br />
  <span style="color: var(--base06);">date</span>       &mdash; Current date/time<br />
  <span style="color: var(--base06);">echo</span>       &mdash; Print arguments<br />
  <span style="color: var(--base06);">close</span>      &mdash; Close scratchpad`);
              break;

            case 'clear':
              clearOutput();
              break;

            case 'close':
              close();
              break;

            case 'whoami':
              printFormatted(`<span style="color: var(--base0D);">USER:</span>  j_kro<br /><span style="color: var(--base05);">HOST:</span>  zephyr.reverb256<br /><span style="color: var(--base05);">ROLE:</span>  operator`);
              break;

            case 'neofetch':
              printFormatted(`<span style="color: var(--base0B);">       ▗▄   ▗▄ ▄▖</span><br />
<span style="color: var(--base09);">      ▄▄▄▄▄▄▄██▛ ▃</span><br />
<span style="color: var(--base05);">        ▟▛    ▜▃▟</span><br />
<span style="color: var(--base0D);">      ██      ██</span><br />
<span style="color: var(--base05);">       ▟▛▙    ▟▛</span><br />
<span style="color: var(--base0B);">       ▟██▀▀▀██▀▀</span><br />
<span style="color: var(--base05);">        ▝▀ ▀▘   ▀▘</span><br />
<span style="color: var(--base06);">  j_kro@zephyr</span><br />
<span style="color: var(--base04);">  OS: ReverbOS (Omarchy) &bull; WM: niri</span><br />
<span style="color: var(--base04);">  Kernel: Linux 7.0.9-cachyos</span>`);
              break;

            case 'status':
              printFormatted(`<span style="color: var(--base0B);">●</span> <span style="color: var(--base06);">reverb256.service</span><br />
<span style="color: var(--base05);">   Loaded: loaded</span><br />
<span style="color: var(--base0B);">   Active: active (running)</span><br />
<span style="color: var(--base05);">   Status: "Serving from Winnipeg. Zero cloud spend."</span>`);
              break;

            case 'banner':
              printFormatted(`<span style="color: var(--base0B);">  ▗▄   ▗▄ ▄▖</span><br />
<span style="color: var(--base09);"> ▄▄▄▄▄▄▄██▛ ▃</span><br />
<span style="color: var(--base05);">   ▟▛    ▜▃▟</span><br />
<span style="color: var(--base0D);"> ██      ██</span><br />
<span style="color: var(--base05);"> ▟▛▙    ▟▛</span><br />
<span style="color: var(--base0B);"> ▟██▀▀▀██▀▀</span><br />
<span style="color: var(--base05);">  ▝▀ ▀▘   ▀▘</span>`);
              break;

            case 'date':
              print(new Date().toLocaleString('en-CA', { timeZone: 'America/Winnipeg' }));
              break;

            case 'echo':
              print(args.join(' ') || '(empty)');
              break;

            default:
              printFormatted(`<span style="color: var(--base08);">scratch: ${command}: command not found</span><br /><span style="color: var(--base05);">Type <span style="color: var(--base0D);">help</span> for available commands.</span>`);
          }
        }

        // ----------------------------------------------------------------
        // Input handler
        // ----------------------------------------------------------------

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            const cmd = input.value.trim();
            if (cmd) {
              execScratchCmd(cmd);
              input.value = '';
            }
          }
        });

        // Focus input when clicking anywhere in the panel
        panel.addEventListener('click', (e) => {
          if (e.target === panel || e.target.closest('#scratch-output')) {
            input.focus();
          }
        });
      });
    </script>

    <!-- GSAP + Particles -->
    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Wait for DOM to be fully ready before initializing animations
      document.addEventListener('DOMContentLoaded', () => {
        // Small delay to ensure all rendering is complete
        setTimeout(initAnimations, 100);
      });

      function initAnimations() {

        // Background glows use CSS keyframes (see global.css) for better Firefox support



        // Mouse position tracking for interactive effects
        let mouseX = 0, mouseY = 0;

        // Particles
        const canvas = document.getElementById("particles") as HTMLCanvasElement;
        const ctx = canvas?.getContext("2d");
        let particles: Array<{x: number; y: number; vx: number; vy: number; size: number; alpha: number}> = [];

        function resizeCanvas() {
          if (canvas) {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
          }
        }
        resizeCanvas();
        window.addEventListener("resize", resizeCanvas);

        function createParticle() {
          return {
            x: Math.random() * (canvas?.width || 0),
            y: Math.random() * (canvas?.height || 0),
            vx: (Math.random() - 0.5) * 0.3,
            vy: (Math.random() - 0.5) * 0.3,
            size: Math.random() * 2 + 0.5,
            alpha: Math.random() * 0.5 + 0.1
          };
        }

        for (let i = 0; i < 25; i++) particles.push(createParticle());

        function animateParticles() {
          if (!ctx || !canvas) return;
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;

            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 255, ${p.alpha})`;
            ctx.fill();
          });

          requestAnimationFrame(animateParticles);
        }
        animateParticles();

        // Interaction tracking for combo system
        let interactionCombo = 0;

        // Track mouse position for interactive effects
        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;

          // Update mouse position CSS variables for all bento items
          document.querySelectorAll('.bento-item').forEach(item => {
            (item as HTMLElement).style.setProperty('--mouse-x', `${mouseX}px`);
            (item as HTMLElement).style.setProperty('--mouse-y', `${mouseY}px`);
          });
        });

        // Combo system for interactions (rhythm game inspired)
        document.querySelectorAll('.bento-item').forEach(card => {
          card.addEventListener('mouseenter', () => {
            interactionCombo++;

            // Celebrate every 5 interactions
            if (interactionCombo % 5 === 0 && interactionCombo > 0) {
              showComboMilestone(interactionCombo);
            }
          });
        });

        function showComboMilestone(combo: number) {
          const milestone = document.createElement('div');
          milestone.className = 'combo-milestone';
          milestone.textContent = `${combo}x COMBO!`;
          document.body.appendChild(milestone);

          setTimeout(() => milestone.remove(), 1500);
        }

        // Element animations with Hoyoverse timing
        const animationConfig = {
          "fade-up": { y: 40, opacity: 0, duration: 0.6, ease: "power2.out" },  // Faster, more responsive
          "fade-in": { scale: 0.95, opacity: 0, duration: 0.4, ease: "power2.out" },
          "slide-right": { x: -40, opacity: 0, duration: 0.6, ease: "power2.out" },
        };

        function isInViewport(el: Element): boolean {
          const rect = el.getBoundingClientRect();
          return rect.top < window.innerHeight && rect.bottom > 0;
        }

        // Process data-animate elements
        document.querySelectorAll("[data-animate]").forEach((el, index) => {
          const type = el.getAttribute("data-animate") as keyof typeof animationConfig;
          const delay = parseFloat(el.getAttribute("data-delay") || "0");
          const config = animationConfig[type] || animationConfig["fade-up"];

          if (isInViewport(el)) {
            // Element already in viewport: set initial state, then animate to final
            gsap.set(el, { y: config.y || 0, x: config.x || 0, scale: config.scale || 1, opacity: 0 });
            gsap.to(el, { y: 0, x: 0, scale: 1, opacity: 1, duration: config.duration, ease: config.ease, delay: delay + 0.1 });
          } else {
            // Element below fold: use scrollTrigger
            gsap.from(el, {
              ...config,
              delay: delay + index * 0.05,
              scrollTrigger: { trigger: el, start: "top 85%", once: true },
            });
          }
        });

        // Process data-stagger containers
        document.querySelectorAll("[data-stagger]").forEach((container) => {
          const items = container.querySelectorAll("[data-stagger-item]");

          // Check if container is already in viewport
          if (isInViewport(container)) {
            // Set initial state and animate immediately
            gsap.set(items, { y: 60, opacity: 0 });
            gsap.to(items, {
              y: 0,
              opacity: 1,
              duration: 0.8,
              stagger: 0.1,
              ease: "power3.out",
              delay: 0.1
            });
          } else {
            // Use scrollTrigger for off-screen containers
            gsap.from(items, {
              y: 60,
              opacity: 0,
              duration: 0.8,
              stagger: 0.1,
              ease: "power3.out",
              scrollTrigger: { trigger: container, start: "top 80%", once: true },
            });
          }
        });

        // Section beat markers (rhythm game-inspired scroll feedback)
        const sections = document.querySelectorAll('section[id]');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('section-active');

              // Add "beat hit" visual on beat indicators
              const indicator = entry.target.querySelector('.beat-indicator');
              if (indicator) {
                indicator.classList.add('active', 'hit');
                setTimeout(() => indicator.classList.remove('hit'), 300);
              }
            } else {
              entry.target.classList.remove('section-active');
              const indicator = entry.target.querySelector('.beat-indicator');
              if (indicator) {
                indicator.classList.remove('active');
              }
            }
          });
        }, { threshold: 0.3 });

        sections.forEach(section => {
          observer.observe(section);
        });
      }
    </script>
  </body>
</html>

