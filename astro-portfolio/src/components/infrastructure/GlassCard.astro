---
/**
 * GlassCard.astro - Reusable TUI card component
 *
 * Features:
 * - Solid surface card with semantic background
 * - Optional icon display
 * - Hover animation with subtle lift
 * - Styled content (p, ul, li)
 * - Compatible with base24 color system
 */

interface Props {
  title: string;
  icon?: string;
  class?: string;
}

const { title, icon, class: className } = Astro.props;
---

<div class={"glass-card " + (className || "")}>
  {icon && (
    <div class="card-icon" aria-hidden="true">
      {icon}
    </div>
  )}
  <h3 class="card-title">{title}</h3>
  <div class="card-content">
    <slot />
  </div>
</div>

<style>
  /* ═════════════════════════════════════════════════════════════
     GLASS CARD STYLES - Glass Morphism Design System
     ═════════════════════════════════════════════════════════════ */

  .glass-card {
    background: var(--surface-default);
    border: 1px solid rgba(138, 146, 168, 0.15);
    border-radius: var(--radius-sm);
    padding: 2rem;
    transition: border-color var(--duration-fast, 150ms) var(--ease-default, ease);
  }

  .glass-card:hover {
    /* no lift on hover — TUI cards are flat */
    border-color: var(--accent-primary);
  }

  /* ═════════════════════════════════════════════════════════════
     CARD ICON
     ═════════════════════════════════════════════════════════════ */

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  /* ═════════════════════════════════════════════════════════════
     CARD TITLE
     ═════════════════════════════════════════════════════════════ */

  .card-title {
    color: var(--text-primary, var(--base07, #f0f2f8));
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  /* ═════════════════════════════════════════════════════════════
     CARD CONTENT
     ═════════════════════════════════════════════════════════════ */

  .card-content {
    color: var(--text-secondary, var(--base06, #c8ced8));
    font-size: var(--text-base, 1rem);
    line-height: 1.6;
  }

  /* Paragraph styling */
  .card-content p {
    margin: 0 0 1rem 0;
  }

  .card-content p:last-child {
    margin-bottom: 0;
  }

  /* List styling */
  .card-content ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-content li {
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: color var(--duration-fast, 150ms) var(--ease-out);
  }

  .card-content li:last-child {
    border-bottom: none;
  }

  .card-content li:hover {
    color: var(--accent-primary, var(--base09));
  }

  /* ═════════════════════════════════════════════════════════════
     REDUCED MOTION
     ═════════════════════════════════════════════════════════════ */

  @media (prefers-reduced-motion: reduce) {
    .glass-card {
      transition: none;
    }

    .glass-card:hover {
      transform: none;
    }
  }

  /* ═════════════════════════════════════════════════════════════
     RESPONSIVE ADJUSTMENTS
     ═════════════════════════════════════════════════════════════ */

  @media (max-width: 768px) {
    .glass-card {
      padding: 1.5rem;
    }

    .card-icon {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
    }

    .card-title {
      font-size: var(--text-lg, 1.125rem);
      margin-bottom: 0.75rem;
    }

    .card-content {
      font-size: var(--text-sm, 0.875rem);
    }
  }
</style>
